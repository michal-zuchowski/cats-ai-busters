// Platform surface helpers.
// - row_ptr - TermScreen row to screen/art pointers
// - put_run - fill a run of tiles
// - vacuum_roof/roof_on/on_vacuum - vacuum roofs as standable surfaces
// - under - ground test below the cat
// - BrushSpin - vacuum brush animation data

func row_ptr {				// x = TermScreen row -> sp (screen), ap (art copy)
  a=RowLo,x
  sp=a
  ap=a
  a=RowHi,x
  sp+1=a
  c+ a-16
  ap+1=a
}

func put_run {				// x = row, y = col, cnt = width, tmp = tile (0 = restore art)
  row_ptr
  {
    a=tmp
    a?0
    == { a=(ap),y }
    (sp),y=a
    y++
    cnt--
  } !=
}

func vacuum_roof {			// PMG origin: roof pixel (24 + row*8 + 2) minus paw row 23
  a=m_arow
  a<< a<< a<<
  c- a+3
}

func roof_on {				// x = slot; a = 1 when the cat's centre column is over that roof's 3 columns
  a=act_col,x
  tmp=a
  a=player_col
  c+ a-tmp
  a?3
  < { a=1 return }
  a=0
}

func on_vacuum {			// a = 1 when standing on a vacuum roof; carrier = which one
  a=m_arow
  a?0
  == { return }
  vacuum_roof
  a?player_y
  != { a=0 return }
  x=0
  roof_on
  a?0
  != { carrier=a=0 a=1 return }
  a=e_bspd
  a?0
  == { return }
  a=e_mode
  a&2
  a?0
  != {
    a=gate
    a?0
    == { return }			// a parked, inactive pursuer must not offer a stuck RIDE
  }
  x=21
  roof_on
  a?0
  == { return }
  carrier=a=21
}

func under {				// a = 1 at a supporting surface, including the vacuum roof
  a=cur_level
  a?0
  == {					// level 01: one flat floor, the hop always lands back on it
    a=player_y
    a?184
    == { a=1 return }
    a=0
    return
  }
  on_vacuum
  a?0
  != { return }
  a=player_y
  a&7
  a?0
  != { a=0 return }
  a=player_y
  a>> a>> a>>
  c+ a-1
  x=a
  row_ptr
  y=player_col
  a=(sp),y
  a&0x7F
  a?70
  == { a=1 return }
  a?94
  == { a=1 return }			// lift; the domed roof is checked above, not as a flat tile
  a?127
  == { a=1 return }			// crumbling catwalk
  a?62
  == { a=1 return }			// controller ledge
  a?79
  == {
    a=cur_level
    a?3
    == { goto under_base }		// electric floor supports the cat; plat_haz checks contact
    a=0
    return
  }
  a?95
  == { goto under_base }
  a?124
  == { goto under_base }
  a?125
  == { goto under_base }
  a=0
  return
under_base:				// a vacuum base drawn over floor: the floor still carries a disarmed cat
  a=(ap),y
  a&0x7F
  a?70
  == { a=1 return }
  a=0
}

data BrushSpin { binary "assets/vacuum-brushes.bin" }

