// Terminal font, zoom tables and the intro terminal text.
// - TermFont - 1K-aligned charset/tile font (also holds the level tile graphics)
// - ZoomLeft/ZoomRight - per-row tables for the zoom-to-terminal push-in
// - CallMouth/CallText - video-call mouth patches (closed/open) and on-screen text
// - Line0..Line6 - terminal lines revealed one by one in the intro (ascii-32 encoding)

data TermFont {
  align 1024
  binary "assets/term-font.pic"
}

data ZoomLeft {
  binary "assets/zoom-left.tbl"
}

data ZoomRight {
  binary "assets/zoom-right.tbl"
}

data CallMouth { // 6 closed bytes, then 6 open bytes (rows 47-49, bytes 16-17)
  binary "assets/call-mouth.tbl"
}

data CallText {
  binary "assets/call-text.pic"
}

data Line0 { // 36 bytes: 'GLOBAL POWER STRUCTURE: ANALYZING...'
    39 44 47 34 33 44 0 48 47 55 37 50 0 51 52 50
    53 35 52 53 50 37 26 0 33 46 33 44 57 58 41 46
    39 14 14 14
}

data Line1 { // 21 bytes: 'RULING SPECIES: HUMAN'
    50 53 44 41 46 39 0 51 48 37 35 41 37 51 26 0
    40 53 45 33 46
}

data Line2 { // 25 bytes: 'THREAT MODEL: HUMANS ONLY'
    52 40 50 37 33 52 0 45 47 36 37 44 26 0 40 53
    45 33 46 51 0 47 46 44 57
}

data Line3 { // 29 bytes: 'PHASE 01: CONTROL INFORMATION'
    48 40 33 51 37 0 16 17 26 0 35 47 46 52 50 47
    44 0 41 46 38 47 50 45 33 52 41 47 46
}

data Line4 { // 32 bytes: 'PHASE 02: CONTROL INFRASTRUCTURE'
    48 40 33 51 37 0 16 18 26 0 35 47 46 52 50 47
    44 0 41 46 38 50 33 51 52 50 53 35 52 53 50 37
}

data Line5 { // 26 bytes: 'PHASE 03: CONTROL HUMANITY'
    48 40 33 51 37 0 16 19 26 0 35 47 46 52 50 47
    44 0 40 53 45 33 46 41 52 57
}

data Line6 { // 27 bytes: 'BEGIN WORLD TAKEOVER? [Y/N]'
    34 37 39 41 46 0 55 47 50 44 36 0 52 33 43 37
    47 54 37 50 31 0 59 57 15 46 61
}

