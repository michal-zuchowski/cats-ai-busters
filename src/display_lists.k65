  repeat 2 { 0x4E &<RevealImg+1480 &>RevealImg+1480 }
  repeat 2 { 0x4E &<RevealImg+1520 &>RevealImg+1520 }
  repeat 2 { 0x4E &<RevealImg+1560 &>RevealImg+1560 }
  repeat 2 { 0x4E &<RevealImg+1600 &>RevealImg+1600 }
  repeat 2 { 0x4E &<RevealImg+1640 &>RevealImg+1640 }
  repeat 2 { 0x4E &<RevealImg+1680 &>RevealImg+1680 }
  repeat 2 { 0x4E &<RevealImg+1720 &>RevealImg+1720 }
  repeat 2 { 0x4E &<RevealImg+1760 &>RevealImg+1760 }
  repeat 2 { 0x4E &<RevealImg+1800 &>RevealImg+1800 }
  repeat 2 { 0x4E &<RevealImg+1840 &>RevealImg+1840 }
  repeat 2 { 0x4E &<RevealImg+1880 &>RevealImg+1880 }
  repeat 2 { 0x4E &<RevealImg+1920 &>RevealImg+1920 }
  repeat 2 { 0x4E &<RevealImg+1960 &>RevealImg+1960 }
  repeat 2 { 0x4E &<RevealImg+2000 &>RevealImg+2000 }
  repeat 2 { 0x4E &<RevealImg+2040 &>RevealImg+2040 }
  repeat 2 { 0x4E &<RevealImg+2080 &>RevealImg+2080 }
  repeat 2 { 0x4E &<RevealImg+2120 &>RevealImg+2120 }
  repeat 2 { 0x4E &<RevealImg+2160 &>RevealImg+2160 }
  repeat 2 { 0x4E &<RevealImg+2200 &>RevealImg+2200 }
  repeat 2 { 0x4E &<RevealImg+2240 &>RevealImg+2240 }
  repeat 2 { 0x4E &<RevealImg+2280 &>RevealImg+2280 }
  repeat 2 { 0x4E &<RevealImg+2320 &>RevealImg+2320 }
  repeat 2 { 0x4E &<RevealImg+2360 &>RevealImg+2360 }
  repeat 2 { 0x4E &<RevealImg+2400 &>RevealImg+2400 }
  repeat 2 { 0x4E &<RevealImg+2440 &>RevealImg+2440 }
  repeat 2 { 0x4E &<RevealImg+2480 &>RevealImg+2480 }
  repeat 2 { 0x4E &<RevealImg+2520 &>RevealImg+2520 }
  repeat 8 { 0x70 }
  repeat 184 { 0x00 }
  0x41 &<dl_storm &>dl_storm
}

