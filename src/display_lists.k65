// ANTIC display lists.
// - dl_term - text/tile terminal and level 01 play screen
// - dl_call - video-call picture (ANTIC D)
// - dl_ai - AI face portrait screen
// - dl_title - title screen
// - dl_storm - panorama pan list, filled at runtime by build_storm_list
// - dl_reveal - panorama reveal with its floor-recolor DLI
// - dl_face - cat face close-up driven by face_kernel
// Bitmap rows are fetched twice with LMS; images are 4K aligned for ANTIC DMA.

// --------------------------- Display lists ---------------------------------
// Every bitmap row is fetched twice with LMS. The 4K-aligned images keep
// each 40-byte DMA fetch within one ANTIC 4K block, even at pan offset 24.

data dl_term {
  nocross
  0x70 0x70				// 16 blank scanlines top margin
  0x44 &<TermScreen &>TermScreen	// row 0 (8 scanlines)
  for x=0..22 eval [0x04]	// rows 1..23 (24 rows total, 192 scanlines)
  0x90					// 2-line gap under the floor; DLI recolours the HUD
  0x04					// row 24: HUD (TermScreen+960)
  0x41 &<dl_term &>dl_term
}

data dl_call {
  nocross
  0x70 0x70 0x70
  0x4D &<CallImg &>CallImg		// 160x80 portrait, 4K-aligned so one LMS is enough
  for x=0..78 eval [0x0D]
  0x70
  0x44 &<TermScreen+840 &>TermScreen+840	// one dialogue row
  0x41 &<dl_call &>dl_call
}

data dl_ai {
  nocross
  0x70 0x70 0x70
  0x4D &<ZoomBuf &>ZoomBuf
  for x=0..78 eval [0x0D]
  0x70
  0x44 &<TermScreen+840 &>TermScreen+840
  0x41 &<dl_ai &>dl_ai
}

data dl_title {
  nocross
  0x70 0x70 0x70
  0x4E &<ZoomBuf &>ZoomBuf
  for x=0..98 eval [0x0E]	// 100 rows, no ANTIC 4K wrap
  0x4E &<TermScreen &>TermScreen
  for x=0..22 eval [0x0E]	// 24 rows, stops before Music
  0x4E &<TitleBottom &>TitleBottom
  for x=0..62 eval [0x0E]	// 64 rows, ends at $C000
  0x30					// last four rows of the mockup are blank
  0x41 &<dl_title &>dl_title
}

// Built at startup: 96 rows, each fetched twice from a 64-byte-wide panorama.
// The extra bytes reserve space for the rows beyond the old static list.
data dl_storm {
  align 1024
  0x70 0x70 0x70
  repeat 2 { 0x4E &<RevealImg &>RevealImg }
  repeat 2 { 0x4E &<RevealImg+40 &>RevealImg+40 }
  repeat 2 { 0x4E &<RevealImg+80 &>RevealImg+80 }
  repeat 2 { 0x4E &<RevealImg+120 &>RevealImg+120 }
  repeat 2 { 0x4E &<RevealImg+160 &>RevealImg+160 }
  repeat 2 { 0x4E &<RevealImg+200 &>RevealImg+200 }
  repeat 2 { 0x4E &<RevealImg+240 &>RevealImg+240 }
  repeat 2 { 0x4E &<RevealImg+280 &>RevealImg+280 }
  repeat 2 { 0x4E &<RevealImg+320 &>RevealImg+320 }
  repeat 2 { 0x4E &<RevealImg+360 &>RevealImg+360 }
  repeat 2 { 0x4E &<RevealImg+400 &>RevealImg+400 }
  repeat 2 { 0x4E &<RevealImg+440 &>RevealImg+440 }
  repeat 2 { 0x4E &<RevealImg+480 &>RevealImg+480 }
  repeat 2 { 0x4E &<RevealImg+520 &>RevealImg+520 }
