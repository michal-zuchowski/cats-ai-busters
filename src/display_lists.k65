  repeat 2 { 0x4E &<RevealImg+680 &>RevealImg+680 }
  repeat 2 { 0x4E &<RevealImg+720 &>RevealImg+720 }
  repeat 2 { 0x4E &<RevealImg+760 &>RevealImg+760 }
  repeat 2 { 0x4E &<RevealImg+800 &>RevealImg+800 }
  repeat 2 { 0x4E &<RevealImg+840 &>RevealImg+840 }
  repeat 2 { 0x4E &<RevealImg+880 &>RevealImg+880 }
  repeat 2 { 0x4E &<RevealImg+920 &>RevealImg+920 }
  repeat 2 { 0x4E &<RevealImg+960 &>RevealImg+960 }
  repeat 2 { 0x4E &<RevealImg+1000 &>RevealImg+1000 }
  repeat 2 { 0x4E &<RevealImg+1040 &>RevealImg+1040 }
  repeat 2 { 0x4E &<RevealImg+1080 &>RevealImg+1080 }
