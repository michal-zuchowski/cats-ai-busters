// Level 01 HUD and main game loop.
// - draw_hud_static/hud_label/hud_bar - bottom HUD row, status label and 12-cell bar
// - draw_lives/lose_life/game_over - lives indicator (cols 9-10), life loss, GAME OVER restart
// - fire_prompt/draw_hud - dynamic HUD updates
// - game_frame - the level 01 per-frame loop

// Row 24 HUD: "ROOM n/3", "Xn" lives, a status label with a 12-cell bar, "LEVEL 01".
func draw_hud_static {
  y=0
  {
    a=MsgHud,y
    TermScreen+961,y=a
    a=MsgLevel,y
    TermScreen+992,y=a
    y++
    y?8
  } !=
  a=cur_room
  c- a+17				// '1'..'3'
  TermScreen+966=a
  call draw_lives			// forward: defined below
}

func draw_lives {			// 'X' + digit at columns 9-10 (between ROOM and the status label)
  TermScreen+969=a=56			// 'X'
  a=lives
  c- a+16				// '0'..'9'
  TermScreen+970=a
}

func lose_life {			// one life lost; the last one ends the game (never returns then)
  a=lives
  a?0
  != { lives-- }
  a=lives
  a?0
  == { call game_over }		// forward: defined below
  draw_lives
}

func game_over {			// GAME OVER on row 0, then back to the title with a fresh game
  call stop_music			// forward: disk_io
  clear_row0
  msg_src=a=&<MsgGameOver
  msg_src+1=a=&>MsgGameOver
  msg_len=a=9
  draw_row0_msg
  x=150 wait_frames			// ~3 s
  goto intro_skip			// resets stack/NMIEN/audio, then title_screen -> init_gameplay with lives=9
}

func hud_label {			// msg_src -> 7 cells at column 11
  y=0
  {
    a=(msg_src),y
    TermScreen+971,y=a
    y++
    y?7
  } !=
}

func hud_bar {				// hud_n filled of 11 cells at columns 19..29
  TermScreen+978=a=122			// HUD_L
  TermScreen+990=a=123			// HUD_R
  x=0
  {
    a=121				// HUD_EMPTY
    x?hud_n
    < { a=120 }				// HUD_FULL
    TermScreen+979,x=a
    x++
    x?11
  } !=
}

naked hud_dli {			// HUD row: gold text, state-coloured bar, blue frame
  a!!
  WSYNC=a
  COLPF0=a=0x1C
  a=hud_col
  COLPF1=a
  COLPF2=a=0x86
  a??
  return_i
}

func fire_prompt {
  hud_col=a=0x1C			// gold
  msg_src=a=&<MsgFireHud
  msg_src+1=a=&>MsgFireHud
  hud_label
  a=RTCLOK				// blinking full bar
  a&16
  == { hud_n=a=11 } else { hud_n=a=0 }
  hud_bar
}

func draw_hud {				// status: alert > switch > relay > blank
  a=alert_timer
  a?0
  != {
    hud_col=a=0x36			// red
    msg_src=a=&<MsgAlertHud
    msg_src+1=a=&>MsgAlertHud
    hud_label
    a=alert_timer			// drains as the alert runs out
    a>> a>> a>>
    hud_n=a
    hud_bar
    return
  }
  a=switch_timer
  a?0
  != {
    hud_col=a=0xC8			// green
    msg_src=a=&<MsgCamOff
    msg_src+1=a=&>MsgCamOff
    hud_label
    a=switch_timer			// 250 frames -> 11 cells: t/32 + t/64 + 1
    a>> a>> a>> a>> a>>
    hud_n=a
    a=switch_timer
    a>> a>> a>> a>> a>> a>>
    c- a+hud_n
    c- a+1
    hud_n=a
    hud_bar
    return
  }
  a=relay_active
  a?0
  != {
    hud_col=a=0x2C			// orange
    msg_src=a=&<MsgRecordHud
    msg_src+1=a=&>MsgRecordHud
    hud_label
    a=relay_progress
    a>> a>> a>>
    hud_n=a
    hud_bar
    return
  }
  a=cur_room				// on the room-2 switch: prompt for fire
  a?1
  == {
    a=player_col
    a?6
    == { fire_prompt return }
  }
  a=cur_room				// on the room-3 relay, until diverted
  a?2
  == {
    a=relay_done
    a?0
    == {
      a=player_col
      a?33
      == { fire_prompt return }
    }
  }
  hud_col=a=0x0C			// white: how far through the room
  msg_src=a=&<MsgHiddenHud
  msg_src+1=a=&>MsgHiddenHud
  hud_label
  a=player_x
  a>> a>> a>> a>>
  c- a+2
  hud_n=a
  hud_bar
}

func game_frame {
  blink_leds
  draw_hud
  a=alert_timer
  a?0
  == {
    read_fire
    read_and_move
    tick_cat
    tick_cams
    tick_switch
    redraw_zone		// repaints the gated play-row tiles
    draw_player		// PMG frame + position
    check_detection
    handle_relay
    return
  }
  alert_timer--
  a=alert_timer
  a?0
  == {
    clear_row0
    redraw_zone
    draw_player
    msg_src=a=&<MsgStop
    msg_src+1=a=&>MsgStop
    msg_len=a=25
    draw_row0_msg
  }
}

