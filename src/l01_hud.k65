// Level 01 HUD and main game loop.
// - draw_hud_static/hud_label - bottom HUD row and its status label
// - draw_lives/lose_life/game_over - nine hearts (cols 19-27), life loss, GAME OVER restart
// - fire_prompt/draw_hud - dynamic HUD updates
// - game_frame - the level 01 per-frame loop

// Row 24 HUD: "ROOM n/3", a status label, nine life hearts, "LEVEL 01".
func draw_hud_static {
  y=0
  {
    a=MsgHud,y
    TermScreen+961,y=a
    a=MsgLevel,y
    TermScreen+992,y=a
    y++
    y?8
  } !=
  a=cur_room
  c- a+17				// '1'..'3'
  TermScreen+966=a
  call draw_lives			// forward: defined below
}

func draw_lives {			// nine hearts at columns 19-27 (where the progress bar was)
  // TermFont has no free glyphs, so the heart (colour 3) is copied into the unused "=" (29) slot.
  // Inverse 157 = remaining life (COLPF3 red), plain 29 = lost life (COLPF2 blue, like the frame).
  y=0
  {
    a=LifeHeart,y
    TermFont+232,y=a			// 29*8
    y++
    y?8
  } !=
  x=0
  {
    a=29
    x?lives
    < { a=157 }
    TermScreen+979,x=a
    x++
    x?9
  } !=
}

func lose_life {			// one life lost; the last one ends the game (never returns then)
  a=lives
  a?0
  != { lives-- }
  a=lives
  a?0
  == { call game_over }		// forward: defined below
  draw_lives
}

func game_over {			// GAME OVER on row 0, then back to the title with a fresh game
  call stop_music			// forward: disk_io
  clear_row0
  msg_src=a=&<MsgGameOver
  msg_src+1=a=&>MsgGameOver
  msg_len=a=9
  draw_row0_msg
  x=150 wait_frames			// ~3 s
  goto intro_skip			// resets stack/NMIEN/audio, then title_screen -> init_gameplay with lives=9
}

func hud_label {			// msg_src -> 7 cells at column 11
  y=0
  {
    a=(msg_src),y
    TermScreen+971,y=a
    y++
    y?7
  } !=
}

naked hud_dli {			// HUD row: gold text, blue frame (red hearts use COLPF3)
  a!!
  WSYNC=a
  COLPF0=a=0x1C
  COLPF2=a=0x86
  a??
  return_i
}

func fire_prompt {
  msg_src=a=&<MsgFireHud
  msg_src+1=a=&>MsgFireHud
  hud_label
}

func draw_hud {				// status: alert > switch > console prompt/RECORD > blank
  a=alert_timer
  a?0
  != {
    msg_src=a=&<MsgAlertHud
    msg_src+1=a=&>MsgAlertHud
    hud_label
    return
  }
  a=switch_timer
  a?0
  != {
    msg_src=a=&<MsgCamOff
    msg_src+1=a=&>MsgCamOff
    hud_label
    return
  }
  a=cur_room				// on the room-2 switch: prompt for fire
  a?1
  == {
    a=player_col
    a?6
    == { fire_prompt return }
  }
  a=cur_room				// room 3: prompt at the console until it plays, then RECORD
  a?2
  == {
    a=relay_done
    a?0
    == {
      a=player_col
      a?27
      >= {
        a?30
        < { fire_prompt return }
      }
    } else {
      msg_src=a=&<MsgRecordHud
      msg_src+1=a=&>MsgRecordHud
      hud_label
      return
    }
  }
  msg_src=a=&<MsgHiddenHud
  msg_src+1=a=&>MsgHiddenHud
  hud_label
}

func game_frame {
  blink_leds
  draw_hud
  a=alert_timer
  a?0
  == {
    read_fire
    read_and_move
    tick_cat
    tick_cams
    tick_switch
    redraw_zone		// repaints the gated play-row tiles
    draw_player		// PMG frame + position
    check_detection
    return
  }
  alert_timer--
  a=alert_timer
  a?0
  == {
    clear_row0
    redraw_zone
    draw_player
    msg_src=a=&<MsgStop
    msg_src+1=a=&>MsgStop
    msg_len=a=25
    draw_row0_msg
  }
}

