  } !=
  AUDC1=a=0
  COLBK=a=0
  x=60
  wait_frames
  // PMG is already off before the first aftermath text write.
  GRACTL=a=0
  SDMCTL=a=0x22
  SDLSTL=a=&<dl_term
  SDLSTH=a=&>dl_term
  CHBAS=a=&>TermFont
  clear_term_screen
  COLOR0=a=0x0E
  COLOR1=a=0x0E
  COLOR2=a=0x0E
  COLOR4=a=0
  kk=a=0
  {
    x=kk
    a=FinRow,x
    x=a
    row_ptr
    a=sp
    c- a+2
    sp=a
    x=kk
    a=FinOff,x
    msg_src=a
    msg_src+1=a=&>Fin
    y=0
    { a=(msg_src),y (sp),y=a y++ y?36 } !=
    x=70
    wait_frames
    kk++
    a=kk
    a?3
  } !=
  x=90
  wait_frames
  kk=a=14
  {
    a=kk
    COLOR0=a
    COLOR1=a
    COLOR2=a
    x=14
    wait_frames
    kk--
    kk--
  } !=
  COLOR0=a=0
  COLOR1=a=0
  COLOR2=a=0
}

func r4_goal {				// returns the room's next action in x
  x=0
  a=gate
  a?0
  != {
    x=1
    a=player_col
    a?23
    >= { x=2 }
    a?33
    >= { x=3 }
  }
  a=R4Off,x
  c- a+&<R4Goal
  msg_src=a
  msg_src+1=a=&>R4Goal
  msg_len=a=36
  draw_row0_msg
  a=R4Hint,x
  x=a
  a=ride
  a?0
  != {
    a=act_col
    a?17
    >= { x=1 }
  }
}

func plat_hud {
  hud_col=a=0x0C
  x=0
  a=cur_level
  a?1
  == {
    a=cur_room
    a?0
    == { x=1 }
    a?2
    == {
      x=3
      a=fan_t
      a&64
      a?0
      == { x=2 }
    }
    sw_ready
    a?0
    != { x=7 }
  }
  a=cur_level
  a?2
  == {
    x=4
    a=ride
    a?0
    != {
      x=5
      a=bw
      a?0
      != { x=6 }
    }
    a=dk
    a?0
    != { x=8 }
    a=e_mode
    a&1
    a?0
    != {
      a=gate
      a?0
      != { x=9 }
    }
    a=cur_room
    a?3
    == { r4_goal }
  }
  a=cur_level
  a?3
  == {
    glass_ready
    a?0 != { x=6 }
  }
  a=HintOff,x
  msg_src=a
  msg_src+1=a=&>Hints
  hud_label
  a=player_x
  a>> a>> a>> a>>
  c- a+2
  hud_n=a
  hud_bar
}

func plat_frame {
  blink_leds
  plat_input
  a=level_finished
  a?0
  != { return }
  plat_phys
  plat_fan
  plat_lift
  plat_crumble
  plat_actor
  plat_pursuer
  paw_both
  plat_hit
  plat_haz
  plat_beam
  plat_dlg
  tick_cat
  plat_hud
  draw_player
}

func frame_any {
  a=cur_level
  a?0
  == { game_frame } else { plat_frame }
}

func init_plat {
  x=cur_level
  a=LvC1,x
  COLOR1=a
  COLOR0=a=0x0A
  COLOR3=a=0x34
  COLOR4=a=0
  init_pmg
  cur_room=a=0
  fire_prev=a=1
  dlg_done=a=0
  entry_col=a=0
  level_finished=a=0
  level_music
  enter_plat_room
}

func next_level {
  a=cur_level
  a?3
  >= { return }
  cur_level++
  init_plat
}

func dbg_level {			// TEST: keys 1-4 jump to level 1-4
  a=CH
  a?0x1F
  == { CH=a=0xFF init_gameplay return }
  a?0x1E
  == { x=1 }
  a?0x1A
  == { x=2 }
  a?0x18
  == { x=3 }
  a?0x1E
  != { a?0x1A != { a?0x18 != { return } } }
  CH=a=0xFF
  cur_level=x
  init_plat
}

func title_screen {
  switch_to_term
  GRACTL=a=0
  SDMCTL=a=0
  DMACTL=a
  cur_room=a=0
  level_finished=a
  disk_dest=a=&<ZoomBuf
  disk_dest+1=a=&>ZoomBuf
  a=22
  load_checked_chunk
  disk_dest=a=&<TermScreen
  disk_dest+1=a=&>TermScreen
  a=23
  load_checked_chunk
  disk_dest=a=&<TitleBottom
  disk_dest+1=a=&>TitleBottom
  a=24
  load_checked_chunk
  init_audio
  a=17
  start_music
  NMIEN=a=0x40				// static bitmap has no DLI
  SDLSTL=a=&<dl_title
  SDLSTH=a=&>dl_title
  COLOR4=a=0x00
  COLOR0=a=0x82
  COLOR1=a=0x0E
  COLOR2=a=0x28
  SDMCTL=a=0x22
  title_phase=a=1
title_release:
  CH=a=0xFF
  x=1 wait_frames
  input_pressed
  a?0
  != { goto title_release }
  CH=a=0xFF
  title_phase=a=2
title_wait:
  x=1 wait_frames
  a=TRIG0
  a&1
  a?0
  == { goto title_start }
  a=CH
  a?0x0C
  == { goto title_start }
  a?0x21
  == { goto title_start }
  goto title_wait
title_start:
  title_phase=a=0
  music_ready=a
  SDMCTL=a
  DMACTL=a
  CH=a=0xFF
  cut_to_black
}

// ---------------------------------- Scene ------------------------------------

main {
  init_system
  build_storm_list

  switch_to_storm			// opening shows racks, but not the cat
  storm_pan				// 5.76-second right-to-left track with blinking LEDs

  show_zoom_bitmap
  zoom_to_terminal			// monitor fills the frame before text appears
  reveal_line0
  x=40 wait_frames
  reveal_line1
  x=40 wait_frames
  reveal_line2
  x=40 wait_frames
  reveal_line3
  x=40 wait_frames
  reveal_line4
  x=40 wait_frames
  reveal_line5
  x=40 wait_frames
  reveal_line6
  x=30 wait_frames

  blink_prompt
  show_y_prompt
  x=60 wait_frames			// let "Y_" sit before pulling back

  show_cat				// add the cat only after the terminal scene
  build_reveal_list
  switch_to_reveal			// cut: pull-back reveal of the cat in the dark
  x=90 wait_frames

  switch_to_face			// cut: close-up cat face
  x=40 wait_frames

  pupils_stage1				// slit -> dilating...
  x=25 wait_frames
  pupils_stage2
  x=25 wait_frames
  pupils_stage3				// ...to fully round
  x=30 wait_frames

  mouth_flag=a=0			// deterministic starting state (closed, matches FaceImg)
  play_meow				// mouth_tick fires from inside this, in sync with audio
  x=40 wait_frames

  video_call
intro_skip:
  NMIEN=a=0x40
  s=x=0xFF				// discard nested intro return addresses after a skip
  AUDC1=a=0
  cut_to_black

  title_screen
  init_gameplay
  {
    x=1
    wait_frames
    dbg_level
    a=level_finished
    a?0
    == { frame_any } else { next_level }
  } always				// gameplay loop; idles forever after the last level
}
