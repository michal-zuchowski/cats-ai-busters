  repeat 2 { 0x4E &<FaceImg+880 &>FaceImg+880 }
  repeat 2 { 0x4E &<FaceImg+920 &>FaceImg+920 }
  repeat 2 { 0x4E &<FaceImg+960 &>FaceImg+960 }
  repeat 2 { 0x4E &<FaceImg+1000 &>FaceImg+1000 }
