  repeat 2 { 0x4E &<RevealImg+2480 &>RevealImg+2480 }
  repeat 2 { 0x4E &<RevealImg+2520 &>RevealImg+2520 }
  repeat 8 { 0x70 }
  repeat 184 { 0x00 }
  0x41 &<dl_storm &>dl_storm
