// ============================================================================
// Playable intro cutscene (no gameplay yet) — see doc/scenario/intro.md and
// doc/tech/graphics.md for the authoritative script/technical plan.
//
//   Beat 1 (ANTIC E, then ANTIC 4): right-to-left track past blinking racks, push in on
//           the terminal, then lines reveal sequentially, followed by a
//           blinking cursor pauses before "Y_" appears (still blinking).
//   Beat 2 (ANTIC E / GR.15 bitmap): a cut pulls back to a facility cat
//           watching from the dark; then a
//           second cut to a close-up cat face whose slit pupils dilate to
//           round in-place (only the eye region's bytes are touched — no
//           whole-image copies per frame).
//   Beat 3: a short PCM meow plays with the mouth genuinely toggled in sync
//           during playback; then a secure video call reveals the boss cat
//           on a faceless human's lap before the cut to black.
//
// Timing uses the OS jiffy clock (RTCLOK, incremented once per VBI) via
// wait_frames; the only DLIs are the reveal's floor recolor and face_kernel. All display-list/color/DMACTL
// changes go through the OS shadow registers (SDLSTL/H, SDMCTL, COLOR0-4) so
// the stock OS deferred-VBI (kept enabled via NMIEN) doesn't stomp them.
// ============================================================================

var mouth_flag		// scratch flag toggled by mouth_tick (auto-allocated byte)
var pan_ptr[2] = 0x84
var pan_phase = 0x86
var led_bit = 0x87
var led_ptr[2] = 0x99
var dl_ptr[2] = 0x88
var strip_ptr[2] = 0x8A
var art_ptr[2] = 0x8C
var zoom_ptr[2] = 0x8E
var zoom_left = 0x90
var zoom_right = 0x91
var zoom_rows = 0x92
var zoom_col = 0x93
var zoom_dest_col = 0x94
var zoom_second_ptr[2] = 0x95
var call_src[2] = 0x97
var call_count = 0x9B
var call_tile = 0x9C
var call_lines_left = 0x9D
var face_groups = 0x9E
var meow_page = 0x9F
var audc_ptr[2] = 0xA0		// AUDC1 while the meow plays, else meow_sink
var meow_sink = 0xA2
var ZoomBuf = 0xA000

// ------------------------- Level 01 gameplay state --------------------------
// Fresh zero-page bytes (no aliasing with intro vars, to avoid any risk of
// two `var` declarations sharing one address); only ever touched after
// cut_to_black, when the intro's own zero-page vars are already dead.
var cur_room = 0xA3		// 0 = corridor, 1 = server aisle, 2 = relay room
var player_col = 0xA4		// 2..38, column of the cat on the play row
var move_timer = 0xA5		// frames until another joystick move is accepted
var fire_prev = 0xA6		// 1 = TRIG0 seen released (arms the next press)
var switch_timer = 0xA7	// room1: frames the switch keeps segment A dark
var art_base[2] = 0xA8		// RoomArt of the current room
var floor_ptr[2] = 0xAA		// art_base + 880: the room's floor row (FLOOR = seen by cameras)
var relay_progress = 0xAC	// frames spent holding the relay terminal
var relay_done = 0xAD		// 1 once the relay is diverted; never cleared by alerts
var relay_active = 0xAE	// 1 while the player is working the relay terminal
var alert_timer = 0xAF		// >0 while "UNRECOGNIZED DEVICE" freezes play
var sfx_timer = 0xB1		// frames left for the current one-shot cue
var mus_timer = 0xB2		// frames until the next music step (16th note)
var mus_step = 0xB3		// 0..255: position in the 16-bar lead
var mus_bar = 0xB0		// bar of the song, 0..15
var lead_vol = 0xBA
var bass_vol = 0xC4
var drum_type = 0xC5		// 0 none, 1 kick, 2 snare, 3 hat
var drum_t = 0xC6		// frame of the drum's 8-frame table

var level_finished = 0xB4	// 1 once the ending has played; freezes game_frame
var entry_col = 0xB5		// player_x to enter the destination room at
var msg_src[2] = 0xB6		// HUD string read pointer (low, high)
var msg_len = 0xB8		// HUD string length for the current row message
var walk_timer = 0xB9		// frames until walking pose returns to idle
var idle_timer = 0xBB		// periodic tail flick while standing still
var player_x = 0xBC		// left pixel of the PMG cat, 0..140 (144 on the exit)
var facing = 0xBD		// 0 = right, 1 = left
var spr_ptr[2] = 0xBE		// CatSprites frame being shown

// Single-line PMG at $B800 (free after the intro): players at $BC00-$BFFF.
// Each base is (player page + 152 scanlines) minus the frame chunk offset
// (0/32/64/96) so one y index walks both the frame and the player.
var PmMem = 0xBC00
var PmP0 = 0xBCB8
var PmP1 = 0xBD98
var PmP2 = 0xBE78
var PmP3 = 0xBF58

// ------------------------------- Terminal text -----------------------------
// ANTIC 4 uses a 3x5 font for ASCII 32..95 mapped to internal (ascii-32).
// Separate foreground and background colors keep white text on green CRT.

// 24 rows x 40 cols in free RAM after ZoomBuf; cleared before each use.
var TermScreen = 0xB000

// Camera cones (page 6 is free on the Atari OS). Two camera slots per room,
// loaded from CamCfg (tools/make_level_art.py CAMERAS); old* hold the cone
// span drawn on each of the 17 rows so it can be erased from RoomArt.
var hud_n = 0x06A0		// HUD bar: filled cells
var hud_col = 0x06A1		// HUD bar colour (state)
var cone_i = 0x0600
var cone_L = 0x0601
var cone_R = 0x0602
var cone_cxl = 0x0603
var cone_cxh = 0x0604
var cone_hwl = 0x0605
var cone_hwh = 0x0606
var cone_sl = 0x0607
var cone_sh = 0x0608
var cone_lc = 0x0609
var cone_rc = 0x060A
var cone_end = 0x060B
var cone_dirty = 0x060C
var cone_hws = 0x060D
var cone_base = 0x060E
var cone_t = 0x060F
var sl_cam = 0x0610		// camera column, 0 = slot unused
var sl_min = 0x0612		// sweep limits (footprint centre column)
var sl_max = 0x0614
var sl_speed = 0x0616		// frames per column
var sl_pause = 0x0618		// frames held at each end
var sl_hw = 0x061A		// footprint half-width in columns
var sl_gate = 0x061C		// 1 = powered down while switch_timer > 0
var sl_hwstep = 0x061E
var sl_c = 0x0620		// footprint centre column
var sl_dir = 0x0622		// 0 = sweeping right, 1 = left
var sl_wait = 0x0624
var sl_on = 0x0626
var oldL = 0x0630		// 2 x 17 rows, 0xFF = nothing drawn
var oldR = 0x0660

data TermFont {
  align 1024
  binary "assets/term-font.pic"
}

data ZoomLeft {
  binary "assets/zoom-left.tbl"
}

data ZoomRight {
  binary "assets/zoom-right.tbl"
}

data CallMouth { // 6 closed bytes, then 6 open bytes (rows 47-49, bytes 16-17)
  binary "assets/call-mouth.tbl"
}

data CallText {
  binary "assets/call-text.pic"
}

data Line0 { // 36 bytes: 'GLOBAL POWER STRUCTURE: ANALYZING...'
    39 44 47 34 33 44 0 48 47 55 37 50 0 51 52 50
    53 35 52 53 50 37 26 0 33 46 33 44 57 58 41 46
    39 14 14 14
}

data Line1 { // 21 bytes: 'RULING SPECIES: HUMAN'
    50 53 44 41 46 39 0 51 48 37 35 41 37 51 26 0
    40 53 45 33 46
}

data Line2 { // 25 bytes: 'THREAT MODEL: HUMANS ONLY'
    52 40 50 37 33 52 0 45 47 36 37 44 26 0 40 53
    45 33 46 51 0 47 46 44 57
}

data Line3 { // 29 bytes: 'PHASE 01: CONTROL INFORMATION'
    48 40 33 51 37 0 16 17 26 0 35 47 46 52 50 47
    44 0 41 46 38 47 50 45 33 52 41 47 46
}

data Line4 { // 32 bytes: 'PHASE 02: CONTROL INFRASTRUCTURE'
    48 40 33 51 37 0 16 18 26 0 35 47 46 52 50 47
    44 0 41 46 38 50 33 51 52 50 53 35 52 53 50 37
}

data Line5 { // 26 bytes: 'PHASE 03: CONTROL HUMANITY'
    48 40 33 51 37 0 16 19 26 0 35 47 46 52 50 47
    44 0 40 53 45 33 46 41 52 57
}

data Line6 { // 27 bytes: 'BEGIN WORLD TAKEOVER? [Y/N]'
    34 37 39 41 46 0 55 47 50 44 36 0 52 33 43 37
    47 54 37 50 31 0 59 57 15 46 61
}

// --------------------------- Level 01 HUD strings ---------------------------
// Same ascii-32 encoding as Line0..Line6, reused for the gameplay HUD rows.
data MsgHud { // 'ROOM 1/3' ... 'LEVEL 01'
  50 47 47 45 0 17 15 19
}
data MsgLevel { // 'LEVEL 01'
  44 37 54 37 44 0 16 17
}
data MsgCamOff { // 'CAM OFF'
  35 33 45 0 47 38 38
}
data MsgRelayHud { // 'RELAY  '
  50 37 44 33 57 0 0
}
data MsgFireHud { // 'FIRE!  '
  38 41 50 37 1 0 0
}
data MsgHiddenHud { // 'HIDDEN '
  40 41 36 36 37 46 0
}
data MsgAlertHud { // 'ALERT  '
  33 44 37 50 52 0 0
}
data MsgStop { // 28 bytes: 'STOP THE RELAY. STAY UNSEEN.'
  51 52 47 48 0 52 40 37 0 50 37 44 33 57 14 0
  51 52 33 57 0 53 46 51 37 37 46 14
}

data MsgAlert { // 19 bytes: 'UNRECOGNIZED DEVICE'
  53 46 50 37 35 47 39 46 41 58 37 36 0 36 37 54
  41 35 37
}

data MsgRoute { // 22 bytes: 'ROUTE: TEST / ISOLATED'
  50 47 53 52 37 26 0 52 37 51 52 0 15 0 41 51
  47 44 33 52 37 36
}

data MsgEnding { // 36 bytes: 'PHASE 02 DELAYED. AGENCY UNDETECTED.'
  48 40 33 51 37 0 16 18 0 36 37 44 33 57 37 36
  14 0 33 39 37 46 35 57 0 53 46 36 37 52 37 35
  52 37 36 14
}

data CamCfg { binary "assets/level-cams.bin" }	// 3 rooms x 2 slots x 8 bytes
data ConeStep { binary "assets/cone-step.bin" }	// d=-40..39: lo[80], hi[80]
data CatSprites { // 28 frames x 128 bytes, see tools/make_cat_sprite.py
  align 256
  binary "assets/cat-sprites.bin"
}
data RoomArt { binary "assets/level-rooms.pic" }

// The panorama is 256x96; the visible window is 160 pixels (40 bytes) wide.
data RevealImg { // 64 bytes x 96 rows, two scanlines per row
  align 4096
  binary "assets/room.pic"
}

data Leds { // lo[], 0, hi[], 0xFF, eor mask[], 0, blink pattern[], 0 (120 LEDs)
  binary "assets/leds.tbl"
}

data BitMasks { 1 2 4 8 16 32 64 128 }

data CatStrip { // last 12 bytes of each of the bottom 32 panorama rows
  binary "assets/cat-strip.pic"
}

data FaceImg { // 40 bytes x 96 rows, two scanlines per row
  align 4096
  binary "assets/face.pic"
}
data CallImg { // 40 bytes x 80 rows, ANTIC D (two scanlines per row)
  align 4096
  binary "assets/call.pic"
}
// --------------------------- Display lists ---------------------------------
// Every bitmap row is fetched twice with LMS. The 4K-aligned images keep
// each 40-byte DMA fetch within one ANTIC 4K block, even at pan offset 24.

data dl_term {
  nocross
  0x70 0x70				// 16 blank scanlines top margin
  0x44 &<TermScreen &>TermScreen	// row 0 (8 scanlines)
  for x=0..22 eval [0x04]	// rows 1..23 (24 rows total, 192 scanlines)
  0x90					// 2-line gap under the floor; DLI recolours the HUD
  0x04					// row 24: HUD (TermScreen+960)
  0x41 &<dl_term &>dl_term
}

data dl_call {
  nocross
  0x70 0x70 0x70
  0x4D &<CallImg &>CallImg		// 160x80 portrait, 4K-aligned so one LMS is enough
  for x=0..78 eval [0x0D]
  0x70
  0x44 &<TermScreen+840 &>TermScreen+840	// one dialogue row
  0x41 &<dl_call &>dl_call
}

// Built at startup: 96 rows, each fetched twice from a 64-byte-wide panorama.
// The extra bytes reserve space for the rows beyond the old static list.
data dl_storm {
  align 1024
  0x70 0x70 0x70
  repeat 2 { 0x4E &<RevealImg &>RevealImg }
