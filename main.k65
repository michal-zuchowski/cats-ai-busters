  repeat 2 { 0x4E &<FaceImg+280 &>FaceImg+280 }
  repeat 2 { 0x4E &<FaceImg+320 &>FaceImg+320 }
  repeat 2 { 0x4E &<FaceImg+360 &>FaceImg+360 }
  0xCE &<FaceImg+400 &>FaceImg+400	// DLI: start face_kernel
  0x4E &<FaceImg+400 &>FaceImg+400
  repeat 2 { 0x4E &<FaceImg+440 &>FaceImg+440 }
  repeat 2 { 0x4E &<FaceImg+480 &>FaceImg+480 }
  repeat 2 { 0x4E &<FaceImg+520 &>FaceImg+520 }
  repeat 2 { 0x4E &<FaceImg+560 &>FaceImg+560 }
  repeat 2 { 0x4E &<FaceImg+600 &>FaceImg+600 }
  repeat 2 { 0x4E &<FaceImg+640 &>FaceImg+640 }
