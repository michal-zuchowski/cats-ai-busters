  FaceImg+2053=a=0
  FaceImg+2049=a=0
  FaceImg+2047=a=0
  FaceImg+2135=a=0
  FaceImg+2133=a=0
  FaceImg+2129=a=0
  FaceImg+2127=a=0
}

func pupils_stage3 {
  FaceImg+1975=a=0
  FaceImg+1973=a=0
  FaceImg+1969=a=0
  FaceImg+1967=a=0
  FaceImg+2015=a=0
  FaceImg+2013=a=0
  FaceImg+2009=a=0
  FaceImg+2007=a=0
  FaceImg+2175=a=0
  FaceImg+2173=a=0
  FaceImg+2169=a=0
  FaceImg+2167=a=0
  FaceImg+2215=a=0
  FaceImg+2213=a=0
  FaceImg+2209=a=0
  FaceImg+2207=a=0
}

// ------------------------------ Mouth sync ----------------------------------
// Called from play_meow's sample loop (once per 256-sample
// page, i.e. 12 times across playback) so the mouth animates during the meow.

inline mouth_open {
  FaceImg+2732=a=0
  FaceImg+2731=a=0
  FaceImg+2772=a=0
  FaceImg+2771=a=0
  FaceImg+2812=a=0
  FaceImg+2811=a=0
  FaceImg+2852=a=0
  FaceImg+2851=a=0
}

inline mouth_close {
  FaceImg+2732=a=175
  FaceImg+2731=a=232
  FaceImg+2772=a=175
  FaceImg+2771=a=232
  FaceImg+2812=a=171
  FaceImg+2811=a=168
  FaceImg+2852=a=170
  FaceImg+2851=a=168
}

func mouth_tick {
  a=mouth_flag
  a^1
  mouth_flag=a
  a?0
  == {
    mouth_close
  } else {
    mouth_open
  }
}

func play_meow {
  x=1 wait_frames			// set up in vblank, outside face_kernel
  meow_ptr=a=&<Meow
  meow_ptr+1=a=&>Meow
  meow_page=a
  audc_ptr=a=&<AUDC1
  audc_ptr+1=a=&>AUDC1
  {
    WSYNC=a
    WSYNC=a
    WSYNC=a
    y=0
    a=(meow_ptr),y
    a|0x10
    AUDC1=a
    meow_ptr++
    == { meow_ptr+1++ }
    a=meow_ptr+1
    a?meow_page != {		// a new 256-sample page (main or kernel crossed it)
      meow_page=a
      check_intro_skip
      mouth_tick			// 12 toggles, one per sample page
      a=meow_page
      a?&>Meow+3072 == break
    }
  } always
  audc_ptr=a=&<meow_sink
  audc_ptr+1=a=&>meow_sink
  AUDC1=a=0
}

func call_mouth {			// x=0 closed, x=6 open
  a=CallMouth,x CallImg+1896=a
  a=CallMouth+1,x CallImg+1897=a
  a=CallMouth+2,x CallImg+1936=a
  a=CallMouth+3,x CallImg+1937=a
  a=CallMouth+4,x CallImg+1976=a
  a=CallMouth+5,x CallImg+1977=a
}

func video_call {
  clear_term_screen
  switch_to_term
  y=0
  {
    a=CallText,y
    TermScreen,y=a
    y++
    y?18
  } !=
  y=0
  {
    a=CallText+18,y
    TermScreen+80,y=a
    y++
    y?27
  } !=
  x=50 wait_frames			// ~4 s total so the connect text can be read
  TermScreen+107=a=14
  x=30 wait_frames
  TermScreen+108=a=14
  x=30 wait_frames
  TermScreen+109=a=14
  x=90 wait_frames

  clear_term_screen
  SDLSTL=a=&<dl_call
  SDLSTH=a=&>dl_call
  COLOR0=a=0x0E			// white Persian cat and subtitles
  COLOR1=a=0x06			// Blofeld's suit and armchair
  COLOR2=a=0x2A			// skin, copper eyes, diamond collar
  COLOR4=a=0x00
  x=35 wait_frames
  call_src=a=&<CallText+45
  call_src+1=a=&>CallText+45
  call_lines_left=a=6
  {
    y=0
    a=(call_src),y
    call_count=a
    a=call_src
    c- a+1
    call_src=a
    c+? { call_src+1++ }
    y=0
    a=0
    {
      TermScreen+840,y=a
      y++
      y?40
    } !=
    y=0
    {
      a=(call_src),y
      TermScreen+840,y=a
      y++
      y?call_count
    } !=
    a=call_src
    c- a+call_count
    call_src=a
    c+? { call_src+1++ }
    a=call_lines_left
    a&1
    a?0 != {
      call_tile=a=4			// boss lines: four mouth flaps with a purr blip
      {
        x=6 call_mouth
        AUDF4=a=0x60
        AUDC4=a=0xA3
        x=6 wait_frames
        x=0 call_mouth
        AUDC4=a=0
        x=6 wait_frames
        call_tile--
        a=call_tile
        a?0
      } !=
      x=152 wait_frames
    } else {
      x=200 wait_frames
    }
    call_lines_left--
    a=call_lines_left
    a?0
  } !=
  x=65 wait_frames
}

// ------------------------------- Cut to black --------------------------------

func cut_to_black {
  COLOR0=a=0
  COLOR1=a=0
  COLOR2=a=0
  COLOR3=a=0
  COLOR4=a=0
  AUDC2=a=0
  AUDC3=a=0
  AUDC4=a=0
}

// ------------------------------ Level 01 gameplay ----------------------------
// Illustrated 40x24 rooms share a walkable row 22; RoomArt provides
// the background, tile IDs 64..124 in TermFont the graphics.
// Ceiling cameras sweep a light cone; the floor under its footprint is seen
// unless a rack stands there (the art's floor row holds SHADOW, not FLOOR).
// cam_sees is both what repaint_current draws and what check_detection uses.

func clear_row0 {
  x=0
  a=0
  {
    TermScreen,x=a
    x++
    x?40
  } !=
}

func clear_row1 {
  x=0
  a=0
  {
    TermScreen+40,x=a
    x++
    x?40
  } !=
}

func draw_row0_msg {			// msg_src/msg_len set by the caller
  y=0
  {
    a=(msg_src),y
    TermScreen,y=a
    y++
    y?msg_len
  } !=
}

func draw_row1_msg {			// msg_src/msg_len set by the caller
  y=0
  {
    a=(msg_src),y
    TermScreen+40,y=a
    y++
    y?msg_len
  } !=
}

func draw_room_header {		// row 1: reuses "CONTROL INFRASTRUCTURE"
  a=cur_room				// from the intro's Line4, or MsgRoute once
  a?2					// the relay in room 2 is diverted
  == {
    a=relay_done
    a?0
    != {
      msg_src=a=&<MsgRoute
      msg_src+1=a=&>MsgRoute
      msg_len=a=22
      draw_row1_msg
      return
    }
  }
  msg_src=a=&<Line4+10
  msg_src+1=a=&>Line4+10
  msg_len=a=22
  draw_row1_msg
}

func draw_frame {			// a = logical frame number; draws it at player_y
  x=a
  a=FrameMap,x
  x=a
  a&1
  a?0
  == { a=0 } else { a=0x80 }
  spr_ptr=a
  a=x
  a>>
  c- a+&>RevealImg
  spr_ptr+1=a
  x=old_y
  y=24
  a=0
  {
    PmMem,x=a
    PmMem+256,x=a
    PmMem+512,x=a
    PmMem+768,x=a
    x++
    y--
  } !=
  y=0
  x=player_y
  { a=(spr_ptr),y PmMem,x=a x++ y++ y?24 } !=
  y=32
  x=player_y
  { a=(spr_ptr),y PmMem+256,x=a x++ y++ y?56 } !=
  y=64
  x=player_y
  { a=(spr_ptr),y PmMem+512,x=a x++ y++ y?88 } !=
  y=96
  x=player_y
  { a=(spr_ptr),y PmMem+768,x=a x++ y++ y?120 } !=
  old_y=a=player_y
  a=player_x
  c- a+48
  HPOSP0=a
  HPOSP2=a
  c- a+8
  HPOSP1=a
  HPOSP3=a
}

func jump_facing {			// a = right-facing leap frame (28..35)
  x=facing
  x?0
  != { c- a+8 }
  draw_frame
}

func draw_player {			// PMG cat: stride frame from x (paws stay planted), else idle
  a=jprep
  a?0
  != { a=28 jump_facing return }
  a=air
  a?0
  != {					// push off, stretch forward, reach down
    a=vy
    a?0xFF
    == { a=30 } else {
      a&0x80
      a?0
      != {
        a=vy
        a?0xFD
        < { a=29 } else { a=30 }
      } else {
        a=vy
        a?1
        >= { a=31 } else { a=30 }
      }
    }
    jump_facing
    return
  }
  a=paw_t
  a?0
  != {
    a=paw_kind
    a?2
    == {				// seated hind-leg shove
      paw_t--
      a=50
      x=paw_t
      x?4
      >= { x?8 < { a=52 } }
      x=facing
      x?0
      != { c- a+1 }
      draw_frame
      return
    }
    paw_t--
    a=paw_t
    a?3
    < { a=28 jump_facing return }	// pull the paw back before standing
    a=paw_kind
    a?0
    == {
      a=paw_t
      a?7
      < {
        a=48
        x=facing
        x?0
        != { a=49 }
        draw_frame
        return
      }
    }
    a=paw_kind
    c- a+44
    x=facing
    x?0
    != { c- a+2 }
    draw_frame
    return
  }
  a=lnd
  a?0
  != {
    a=lnd
    a?9
    >= { a=32 } else {
      a?6
      >= { a=33 } else {
        a?3
        >= { a=34 } else { a=35 }
      }
    }
    lnd--
    jump_facing
    return
  }
  a=ride
  a?0
  != {
    a=cur_level
    a?2
    == {				// seated on a vacuum roof
      a=50
      x=facing
      x?0
      != { a=51 }
      draw_frame
      return
    }
  }
  a=walk_timer
  a?0
  == {
    a=idle_timer
    a?30
    >= { a=13 } else { a=12 }
  } else {
    a=player_x			// 1 drawing per colour clock
    { a?12 >= { c+ a-12 } } >=	// mod 12: 12-drawing stride
    x=facing
    x?0
    != { a^0xFF c- a+12 }		// mirrored frames play forward while x falls
  }
  x=facing
  x?0
  != { c- a+14 }
  draw_frame
}

func set_col {				// player_col = column under the cat's middle
  a=player_x
  c- a+2
  a>>
  a>>
  c- a+2
  player_col=a
}

func cat_stepped {			// 1 px per 3 frames: half-size cat, same leg cadence
  walk_timer=a=4
  move_timer=a=2
  set_col
}

func tick_cat {
  a=walk_timer
  a?0
  != { walk_timer-- }
  idle_timer++
  a=idle_timer
  a?40
  >= { idle_timer=a=0 }
}

func repaint_current {			// repaints play-row column x for the current room
  a=cur_room
  a?2
  == {
    x?33
    == {
      a=relay_done
      a?0
      == { a=83 } else { a=84 }
      TermScreen+880,x=a
      return
    }
    x?38
    == {
      a=relay_done
      a?0
      == { a=81 } else { a=85 }
      TermScreen+880,x=a
      return
    }
  }
  call cam_sees
  a?0
  != { a=117 TermScreen+880,x=a return }
  a=x
  y=a
  a=(floor_ptr),y
  TermScreen+880,x=a
}

func init_pmg {
  a=0
  y=0
  {
    PmMem,y=a
    PmMem+256,y=a
    PmMem+512,y=a
    PmMem+768,y=a
    y++
    y?0
  } !=
  a=0					// normal-width players: half-size cat
  SIZEP0=a
  SIZEP1=a
  SIZEP2=a
  SIZEP3=a
  PMBASE=a=0xB8
  GRACTL=a=2				// players only
  SDMCTL=a=0x3A				// playfield + single-line player DMA
  GPRIOR=a=1				// cat in front of the racks
  PCOLR0=a=0x24				// P0/P1: stripes, nose, far legs (dark ginger)
  PCOLR1=a=0x24
  PCOLR2=a=0x2C				// P2/P3: ginger fur
  PCOLR3=a=0x2C
}

// ---- Room 0: corridor. cols 2..14 shelter, 15..24 camera strip, 25..37 open.






func redraw_zone {
  x=2
  { repaint_current x++ x?40 } !=
}

func cam_sees {				// x = column -> a: 1 if a live camera footprint covers open floor
  a=x
  cone_t=a
  y=a
  a=(floor_ptr),y
  a?70
  != { a=0 return }
  y=0
  {
    a=sl_cam,y
    a?0
    != {
      a=sl_on,y
      a?0
      != {
        a=cone_t
        c+ a-sl_c,y
        < { a^0xFF c- a+1 }		// |x - centre|
        a?sl_hw,y
        < { a=1 return }
        == { a=1 return }
      }
    }
    y++
    y?2
  } !=
  a=0
}

func load_cams {			// CamCfg row for cur_room -> both slots, sweeps restart
  a=cur_room
  a<<
  a<<
  a<<
  a<<
  y=a
  x=0
  {
    a=CamCfg,y sl_cam,x=a y++
    a=CamCfg,y sl_min,x=a sl_c,x=a y++
    a=CamCfg,y sl_max,x=a y++
    a=CamCfg,y sl_speed,x=a sl_wait,x=a y++
    a=CamCfg,y sl_pause,x=a y++
    a=CamCfg,y sl_hw,x=a y++
    a=CamCfg,y sl_gate,x=a y++
    a=CamCfg,y sl_hwstep,x=a y++
    a=0
    sl_dir,x=a
    sl_on,x=a
    x++
    x?2
  } !=
  x=0
  { a=0xFF oldL,x=a x++ x?34 } !=
  cone_dirty=a=1
}

func tick_cam {				// x = slot
  a=sl_cam,x
  a?0
  != {
    a=sl_gate,x
    a?0
    != {
      a=switch_timer
      a?0
      == { a=1 } else { a=0 }
    } else { a=1 }
    a?sl_on,x
    != { sl_on,x=a cone_dirty=a=1 }
    a=sl_wait,x
    a?0
    == {
      a=sl_speed,x
      sl_wait,x=a
      a=sl_dir,x
      a?0
      == { a=sl_c,x c- a+1 } else { a=sl_c,x c+ a-1 }
      sl_c,x=a
      a?sl_max,x
      == { a=1 sl_dir,x=a a=sl_pause,x sl_wait,x=a }
      a=sl_c,x
      a?sl_min,x
      == { a=0 sl_dir,x=a a=sl_pause,x sl_wait,x=a }
      cone_dirty=a=1
    } else {
      c+ a-1
      sl_wait,x=a
    }
  }
}

func tick_cams {			// sweep each camera; redraw cones when anything moved
  x=0
  tick_cam
  x=1
  tick_cam
  a=cone_dirty
  a?0
  != { cone_dirty=a=0 call redraw_cones }
}

func cone_rows_start {			// zoom_ptr/art_ptr -> row 5 of screen/room art
  zoom_ptr=a=&<TermScreen+200
  zoom_ptr+1=a=&>TermScreen+200
  a=art_base
  c- a+200
  art_ptr=a
  a=art_base+1
  a+0
  art_ptr+1=a
}

func cone_rows_next {
  a=zoom_ptr
  c- a+40
  zoom_ptr=a
  a=zoom_ptr+1
  a+0
  zoom_ptr+1=a
  a=art_ptr
  c- a+40
  art_ptr=a
  a=art_ptr+1
  a+0
  art_ptr+1=a
}

func erase_slot {			// cone_base = 0/17: restore that slot's spans from RoomArt
  cone_rows_start
  cone_i=a=0
  {
    a=cone_base
    c- a+cone_i
    x=a
    a=oldL,x
    a?0xFF
    != {
      y=a
      a=oldR,x
      c- a+1
      cone_end=a
      {
        a=(art_ptr),y
        (zoom_ptr),y=a
        y++
        a=y
        a?cone_end
      } !=
      a=0xFF
      oldL,x=a
    }
    cone_rows_next
    cone_i++
    a=cone_i
    a?17
  } !=
}

func cone_row {				// one row of the cone: advance the DDA, draw its span
  a=cone_cxl
  c- a+cone_sl
  cone_cxl=a
  a=cone_cxh
  a+cone_sh
  cone_cxh=a
  a=cone_hwl
  c- a+cone_hws
  cone_hwl=a
  a=cone_hwh
  a+0
  cone_hwh=a
  a=cone_cxh
  c+ a-cone_hwh
  < { a=0 }
  cone_L=a
  a=cone_cxh
  c- a+cone_hwh
  >= { a=159 }
  a?160
  >= { a=159 }
  cone_R=a
  a=cone_L
  a>>
  a>>
  cone_lc=a
  a=cone_R
  a>>
  a>>
  cone_rc=a
  c- a+1
  cone_end=a
  a=cone_base
  c- a+cone_i
  x=a
  a=cone_lc
  oldL,x=a
  y=a
  a=cone_rc
  oldR,x=a
  {
    a=(art_ptr),y
    a?64
    == {
      a=y
      a?cone_lc
      == {
        a=cone_L
        a&3
        c- a+109
      } else {
        a?cone_rc
        == {
          a=cone_R
          a&3
          c- a+113
        } else { a=109 }
      }
      (zoom_ptr),y=a
    }
    y++
    a=y
    a?cone_end
  } !=
}

func draw_cone {			// x = slot: 17 rows of light from the lens to the floor
  a=sl_cam,x
  a?0
  == { return }
  a=sl_on,x
  a?0
  == { return }
  a=x
  a?0
  == { a=0 } else { a=17 }
  cone_base=a
  a=sl_hwstep,x
  cone_hws=a
  a=sl_c,x
  c+ a-sl_cam,x
  c- a+40
  y=a
  a=ConeStep,y
  cone_sl=a
  a=ConeStep+80,y
  cone_sh=a
  a=sl_cam,x
  a<<
  a<<
  c- a+2
  cone_cxh=a
  cone_cxl=a=0x80
  cone_hwl=a=0
  cone_hwh=a=1
  cone_rows_start
  cone_i=a=0
  {
    cone_row
    cone_rows_next
    cone_i++
    a=cone_i
    a?17
  } !=
}

func cam_tiles {			// camera glyph turns with the sweep; lens red while live
  x=0
  {
    a=sl_cam,x
    a?0
    != {
      y=a
      a=sl_c,x
      c- a+1
      a?sl_cam,x
      < { a=118 } else {
        a=sl_cam,x
        c- a+1
        a?sl_c,x
        < { a=119 } else { a=68 }
      }
      cone_t=a
      a=sl_on,x
      a?0
      != { a=cone_t a|0x80 cone_t=a }
      a=cone_t
      TermScreen+160,y=a
    }
    x++
    x?2
  } !=
}

func redraw_cones {
  cone_base=a=0
  erase_slot
  cone_base=a=17
  erase_slot
  x=0
  draw_cone
  x=1
  draw_cone
  cam_tiles
}


func tick_switch {			// switch_timer was set-but-never-decremented; without
  a=switch_timer			// this the segment stayed dark (or watched, after the
  a?0				// polarity fix above) forever instead of timing out.
  == { return }
  switch_timer--
}

func check_detection {
  x=player_col
  cam_sees
  a?0
  != { call trigger_alert }
}

func trigger_alert {			// ignored while already alerting; relay_done is untouched
  a=alert_timer
  a?0
  != { return }
  alert_timer=a=90
  relay_progress=a=0
  relay_active=a=0
  switch_timer=a=0
  player_x=a=0
  facing=a=0
  set_col
  walk_timer=a=0
  draw_player
  clear_row0
  msg_src=a=&<MsgAlert
  msg_src+1=a=&>MsgAlert
  msg_len=a=19
  draw_row0_msg
  call sfx_alert
}

func handle_relay {
  a=relay_active
  a?0
  == { return }
  a=player_col
  a?33
  != { relay_active=a=0 relay_progress=a=0 return }
  relay_progress++
  a=relay_progress
  a?90
  >= {
    relay_done=a=1
    relay_active=a=0
    x=33
    repaint_current
    x=38
    repaint_current
    clear_row1
    msg_src=a=&<MsgRoute
    msg_src+1=a=&>MsgRoute
    msg_len=a=22
    draw_row1_msg
    call sfx_success
  }
}

func read_fire {			// edge-triggered: one action per press-release cycle
  a=TRIG0
  a&1
  a?0
  != { fire_prev=a=1 return }
  a=fire_prev
  a?0
  == { return }
  fire_prev=a=0
  a=cur_room
  a?1
  == {
    a=player_col
    a?6
    == { switch_timer=a=250 call sfx_switch }
    return
  }
  a=cur_room
  a?2
  == {
    a=player_col
    a?33
    == {
      a=relay_done
      a?0
      == { relay_active=a=1 }
    }
  }
}

func read_and_move {
  a=move_timer
  a?0
  != { move_timer-- return }

  a=PORTA
  a&4
  a?0
  == {
    facing=a=1
    a=player_x
    a?0
    == {
      a=cur_room
      a?0
      != {
        entry_col=a=136
        cur_room--
        call enter_room
      }
      move_timer=a=6
      return
    }
    player_x--
    cat_stepped
    return
  }

  a=PORTA
  a&8
  a?0
  == {
    facing=a=0
    a=player_x
    a?140
    == {
      a=cur_room
      a?2
      == {
        a=relay_done
        a?0
        == { move_timer=a=6 return }
        player_x=a=144
        cat_stepped
        draw_player
        call level_ending
        return
      }
      entry_col=a=0
      cur_room++
      call enter_room
      move_timer=a=6
      return
    }
    player_x++
    cat_stepped
    return
  }
}

func sfx_switch { AUDF4=a=80 AUDC4=a=0xA8 sfx_timer=a=8 }
func sfx_alert { AUDF4=a=40 AUDC4=a=0xAF sfx_timer=a=20 }
func sfx_success { AUDF4=a=100 AUDC4=a=0xA6 sfx_timer=a=40 }

func tick_audio {
  a=sfx_timer
  a?0
  != {
    sfx_timer--
    a=sfx_timer
    a?0
    == {
      a=disk_busy			// ch4 is disk_read's during a load; don't re-arm it
      a?0
      == { AUDC4=a=0 }
    }
  }
  a=music_ready
  a?0
  != { call tick_music }
}

// Track layout: tools/make_music.py. ch1+2 = 16-bit 1.79 MHz lead,
// ch3 octave bass, ch4 drums yielding to SFX and disk I/O.

func music_step {
  mus_timer=a=Music+432
  x=mus_step
  a=Music,x				// lead: 0 nothing new, 1 cut, k >= 2 note k
  a?2
  >= {
    y=a
    a=Music+334,y			// note k: AUDF1/AUDF2 at 336/352 + k - 2
    AUDF1=a
    a=Music+350,y
    AUDF2=a
    lead_vol=a=Music+433
  }
  a=Music,x
  a?1
  == { lead_vol=a=0 }
  a=mus_step
  a>> a>> a>> a>>
  mus_bar=a
  y=a
  a=mus_step
  a&15
  x=a
  a=mus_bar				// every 4th bar plays the drum fill
  a&3
  a?3
  == { a=x c- a+16 x=a }
  a=Music+272,x				// drum hit
  a?0
  != { drum_type=a drum_t=a=0 }
  a=mus_step
  a&15
  x=a
  a=Music+256,x				// bass: 1 root, 2 octave up
  a?1
  == { a=Music+304,y bass_freq=a bass_vol=a=Music+434 }
  a=Music+256,x
  a?2
  == { a=Music+320,y bass_freq=a bass_vol=a=Music+434 }
  mus_step++				// wraps at 256 = 16 bars
}

func tick_music {
  mus_timer--
  a=mus_timer
  a?0
  == { music_step }
  a=lead_vol				// pluck decay; attack volume is track-specific
  a?0
  != {
    a=RTCLOK
    a&1
    == { lead_vol-- }
  }
  a=lead_vol
  a|0xA0
  AUDC2=a				// the joined pair's volume lives in AUDC2; SIO never
					// touches ch1/2, so the lead keeps sounding through a
					// disk_read unattended (a3e.4).
  a=disk_busy				// ch3/ch4 are disk_read's baud clock during a load:
  a?0				// bass/drums stay muted (as disk_read already left them)
  != { return }			// until the load clears, then resume from queued state
  a=bass_freq
  AUDF3=a
  a=bass_vol
  a?0
  != { bass_vol-- }
  a|0xA0
  AUDC3=a
  a=sfx_timer				// sound effects own ch4
  a?0
  != { return }
  a=drum_type				// row = type * 8 + frame
  a<< a<< a<<
  c- a+drum_t
  x=a
  a=Music+368,x
  AUDF4=a
  a=Music+400,x
  AUDC4=a
  a=drum_t
  a?7
  != { drum_t++ }
}

naked music_vbi_imm {			// hooked into VVBLKI (immediate stage): unlike VVBLKD,
					// this still runs while SIO sets CRITIC and skips stage 2,
					// so the lead (ch1+2) keeps ticking through a disk_read.
					// Chains to the saved OS vector -- NOT XITVBV -- so RTCLOK
					// and the OS's own stage-2 dispatch still happen.
  a=level_finished
  a?0
  == { tick_audio }
  goto (old_vviblki)
}

func load_room_chunk {			// a = chunk index; streams it to disk_dest (ChunkTable, 5 bytes/entry)
  tmp=a
  a<< a<<
  c- a+tmp
  x=a
  a=ChunkTable,x
  disk_sector=a
  x++
  a=ChunkTable,x
  disk_sector+1=a
  x++
  a=ChunkTable,x
  disk_count=a
  x++
  a=ChunkTable,x
  disk_count+1=a
  call disk_read
}

func load_room_art {			// a = chunk index: streams the 960-byte art (+ metadata) into
					// RoomArtBuf (a3e.3), then paints it onto TermScreen
  cnt=a
  disk_dest=a=&<RoomArtBuf
  disk_dest+1=a=&>RoomArtBuf
  a=cnt
  call load_room_chunk
  call paint_room_art
}

func paint_room_art {
  art_ptr=a=&<RoomArtBuf
  art_ptr+1=a=&>RoomArtBuf
  a=art_ptr
  art_base=a
  c- a+0x70
  floor_ptr=a
  a=art_ptr+1
  art_base+1=a
  a+0x03
  floor_ptr+1=a
  zoom_ptr=a=&<TermScreen
  zoom_ptr+1=a=&>TermScreen
  x=3
  {
    y=0
    {
      a=(art_ptr),y
      (zoom_ptr),y=a
      y++
      y?0
    } !=
    art_ptr+1++
    zoom_ptr+1++
    x--
    x?0
  } !=
  y=0
  {
    a=(art_ptr),y
    (zoom_ptr),y=a
    y++
    y?192
  } !=
}

func enter_room {
  a=entry_col
  player_x=a
  set_col
  switch_timer=a=0
  relay_active=a=0
  relay_progress=a=0
  walk_timer=a=0
  idle_timer=a=0
  a=cur_room
  load_room_art
  load_cams
  call draw_hud_static
  clear_row1
  draw_room_header
  msg_src=a=&<MsgStop
  msg_src+1=a=&>MsgStop
  msg_len=a=28
  draw_row0_msg
  redraw_zone
  draw_player
}

func level_ending {
  level_finished=a=1
  clear_row0
  clear_row1
  x=cur_level
  a=TxtOff,x
  msg_src=a
  msg_src+1=a=&>Txt
  msg_len=a=36
  draw_row0_msg
  sfx_success
  x=75
  wait_frames
  x=75
  wait_frames
  COLOR0=a=0
  COLOR1=a=0
  COLOR2=a=0
  COLOR4=a=0
  PCOLR0=a=0
  PCOLR1=a=0
  PCOLR2=a=0
  PCOLR3=a=0
  AUDC1=a=0
  AUDC2=a=0
  AUDC3=a=0
  AUDC4=a=0
}

func blink_leds {			// toggle the LED pixel in the SRV_B/SRV_D glyphs (tiles 73/75)
  a=RTCLOK
  a&0x20					// slow blink, ~0.6 s
  a>> a>> a>>
  a|0xAA
  TermFont+586=a			// 73*8+2: "2232" / "2222"
  a=RTCLOK
  a&0x08					// fast activity flicker
  a<<
  a|0xAA
  TermFont+604=a			// 75*8+4: "2322" / "2222"
}

// Row 24 HUD: "ROOM n/3", a status label with a 12-cell bar, "LEVEL 01".
func draw_hud_static {
  y=0
  {
    a=MsgHud,y
    TermScreen+961,y=a
    a=MsgLevel,y
    TermScreen+992,y=a
    y++
    y?8
  } !=
  a=cur_room
  c- a+17				// '1'..'3'
  TermScreen+966=a
}

func hud_label {			// msg_src -> 7 cells at column 11
  y=0
  {
    a=(msg_src),y
    TermScreen+971,y=a
    y++
    y?7
  } !=
}

func hud_bar {				// hud_n filled of 11 cells at columns 19..29
  TermScreen+978=a=122			// HUD_L
  TermScreen+990=a=123			// HUD_R
  x=0
  {
    a=121				// HUD_EMPTY
    x?hud_n
    < { a=120 }				// HUD_FULL
    TermScreen+979,x=a
    x++
    x?11
  } !=
}

naked hud_dli {			// HUD row: gold text, state-coloured bar, blue frame
  a!!
  WSYNC=a
  COLPF0=a=0x1C
  a=hud_col
  COLPF1=a
  COLPF2=a=0x86
  a??
  return_i
}

func fire_prompt {
  hud_col=a=0x1C			// gold
  msg_src=a=&<MsgFireHud
  msg_src+1=a=&>MsgFireHud
  hud_label
  a=RTCLOK				// blinking full bar
  a&16
  == { hud_n=a=11 } else { hud_n=a=0 }
  hud_bar
}

func draw_hud {				// status: alert > switch > relay > blank
  a=alert_timer
  a?0
  != {
    hud_col=a=0x36			// red
    msg_src=a=&<MsgAlertHud
    msg_src+1=a=&>MsgAlertHud
    hud_label
    a=alert_timer			// drains as the alert runs out
    a>> a>> a>>
    hud_n=a
    hud_bar
    return
  }
  a=switch_timer
  a?0
  != {
    hud_col=a=0xC8			// green
    msg_src=a=&<MsgCamOff
    msg_src+1=a=&>MsgCamOff
    hud_label
    a=switch_timer			// 250 frames -> 11 cells: t/32 + t/64 + 1
    a>> a>> a>> a>> a>>
    hud_n=a
    a=switch_timer
    a>> a>> a>> a>> a>> a>>
    c- a+hud_n
    c- a+1
    hud_n=a
    hud_bar
    return
  }
  a=relay_active
  a?0
  != {
    hud_col=a=0x2C			// orange
    msg_src=a=&<MsgRelayHud
    msg_src+1=a=&>MsgRelayHud
    hud_label
    a=relay_progress
    a>> a>> a>>
    hud_n=a
    hud_bar
    return
  }
  a=cur_room				// on the room-2 switch: prompt for fire
  a?1
  == {
    a=player_col
    a?6
    == { fire_prompt return }
  }
  a=cur_room				// on the room-3 relay, until diverted
  a?2
  == {
    a=relay_done
    a?0
    == {
      a=player_col
      a?33
      == { fire_prompt return }
    }
  }
  hud_col=a=0x0C			// white: how far through the room
  msg_src=a=&<MsgHiddenHud
  msg_src+1=a=&>MsgHiddenHud
  hud_label
  a=player_x
  a>> a>> a>> a>>
  c- a+2
  hud_n=a
  hud_bar
}

func game_frame {
  blink_leds
  draw_hud
  a=alert_timer
  a?0
  == {
    read_fire
    read_and_move
    tick_cat
    tick_cams
    tick_switch
    redraw_zone		// repaints the gated play-row tiles
    draw_player		// PMG frame + position
    check_detection
    handle_relay
    return
  }
  alert_timer--
  a=alert_timer
  a?0
  == {
    clear_row0
    redraw_zone
    draw_player
    msg_src=a=&<MsgStop
    msg_src+1=a=&>MsgStop
    msg_len=a=28
    draw_row0_msg
  }
}

// Reads disk_count sectors starting at disk_sector into disk_dest via SIOV
// (params in zero page; see the disk_* vars above). SIO drives POKEY ch3/ch4
// as its baud clock and needs a clean AUDCTL, so channels 3/4 are silenced
// and AUDCTL is zeroed for the transfer; callers get AUDCTL back at 0x50
// (ch1 at 1.79MHz, ch1+2 joined for the 16-bit lead -- see init_audio).
// a3e.4 will keep the lead itself audible during the read.
func disk_read {
  disk_busy=a=1				// tick_music (a3e.4) mutes ch3/ch4 while this is set
  disk_failed=a=0
  AUDC3=a=0
  AUDC4=a=0
  AUDCTL=a=0

  a=disk_dest DBUFLO=a
  a=disk_dest+1 DBUFHI=a
  a=disk_sector DAUX1=a
  a=disk_sector+1 DAUX2=a

  {
    DDEVIC=a=0x31			// disk drive 1
    DUNIT=a=1
    DCOMND=a=0x52			// 'R' read sector
    DSTATS=a=0x40			// peripheral -> memory
    DTIMLO=a=0x0F
    DBYTLO=a=128
    DBYTHI=a=0
    call SIOV
    y?1					// SIO returns Y=1 on success
    != { disk_failed=a=1 }

    a=DBUFLO
    c- a+128
    DBUFLO=a
    c+? { DBUFHI++ }

    DAUX1++
    z+? { DAUX2++ }

    a=disk_count
    z+? { disk_count+1-- }
    disk_count--
    a=disk_count
    a|disk_count+1
  } !=

  AUDCTL=a=0x50
  disk_busy=a=0
}

func disk_checksum {			// disk_ptr = buffer; x = number of 128-byte sectors
  disk_chk=a=0
  {
    y=0
    {
      a=(disk_ptr),y
      c- a+disk_chk
      disk_chk=a
      y++
      y?128
    } !=
    a=disk_ptr
    c- a+128
    disk_ptr=a
    c+? { disk_ptr+1++ }
    x--
    x?0
  } !=
}

// Boot-time smoke test: loads ChunkTable's chunk 0 (room 0's disk-streamed
// art, a3e.3) into the unused intro ZoomBuf scratch, checksums it, and
// flashes "DISK OK"/"DISKERR" on the term screen for 90 frames before
// gameplay starts. Never touches any resident gameplay state.
func disk_selftest {
  disk_sector=a=ChunkTable
  disk_sector+1=a=ChunkTable+1
  disk_count=a=ChunkTable+2
  disk_count+1=a=ChunkTable+3
  disk_dest=a=&<ZoomBuf
  disk_dest+1=a=&>ZoomBuf
  call disk_read

  disk_ptr=a=&<ZoomBuf
  disk_ptr+1=a=&>ZoomBuf
  x=ChunkTable+2
  disk_checksum

  msg_src=a=&<MsgDiskErr
  msg_src+1=a=&>MsgDiskErr
  a=disk_chk
  c+ a-ChunkTable+4
  == {
    msg_src=a=&<MsgDiskOk
    msg_src+1=a=&>MsgDiskOk
  }
  clear_term_screen
  hud_label
  x=90
  wait_frames
}

func load_level_assets {		// CamCfg/ConeStep (a3e.3): shared by all 3 rooms, loaded
					// once per level rather than reloaded on every room entry
  disk_sector=a=ChunkTable+15
  disk_sector+1=a=ChunkTable+16
  disk_count=a=ChunkTable+17
  disk_count+1=a=ChunkTable+18
  disk_dest=a=&<CamCfg
  disk_dest+1=a=&>CamCfg
  call disk_read

  disk_sector=a=ChunkTable+20
  disk_sector+1=a=ChunkTable+21
  disk_count=a=ChunkTable+22
  disk_count+1=a=ChunkTable+23
  disk_dest=a=&<ConeStep
  disk_dest+1=a=&>ConeStep
  call disk_read

  disk_dest=a=&<RevealImg
  disk_dest+1=a=&>RevealImg
  a=16
  load_room_chunk
}

func stop_music {
  music_ready=a=0
  sfx_timer=a
  AUDC1=a
  AUDC2=a
  AUDC3=a
  AUDC4=a
}

func music_failure {
  stop_music
  switch_to_term
  GRACTL=a=0
  clear_term_screen
  SDMCTL=a=0x22
  msg_src=a=&<MsgDiskErr
  msg_src+1=a=&>MsgDiskErr
  msg_len=a=7
  clear_row0
  draw_row0_msg
  { x=1 wait_frames } always
}

func load_checked_chunk {		// a = chunk index; returns the verified checksum in A
  x=a
  tmp=a
  a<< a<<
  c- a+tmp
  cnt=a
  a=x
  load_room_chunk
  a=disk_failed
  a?0
  != { music_failure }
  disk_ptr=a=disk_dest
  disk_ptr+1=a=disk_dest+1
  x=cnt
  a=ChunkTable+2,x
  x=a
  disk_checksum
  x=cnt
  a=disk_chk
  a?ChunkTable+4,x
  != { music_failure }
}

func start_music {			// a = title chunk 17 or level chunk 18..21
  music_chunk=a
  stop_music
  disk_dest=a=&<Music
  disk_dest+1=a=&>Music
  a=music_chunk
  load_checked_chunk
  a=Music+432
  a?0
  == { music_failure }
  a?16
  >= { music_failure }
  a=Music+433
  a?16
  >= { music_failure }
  a=Music+434
  a?16
  >= { music_failure }
  mus_timer=a=1
  mus_step=a=0
  mus_bar=a
  lead_vol=a
  bass_vol=a
  bass_freq=a
  drum_type=a
  drum_t=a
  music_ready=a=1
}

func level_music {
  a=cur_level
  c- a+18
  start_music
}

func init_audio {
  stop_music
  AUDCTL=a=0x50				// ch1 at 1.79 MHz, ch1+ch2 joined (16-bit lead)
  disk_busy=a=0
  NMIEN=a=0x80				// no VBI while the vector is half written
  a=VVBLKI+1
  a?&>music_vbi_imm
  != {				// skip on re-init (debug level switch): vector already ours
    a=VVBLKI old_vviblki=a	// save the OS's stage-1 handler, then chain to it so
    a=VVBLKI+1 old_vviblki+1=a	// RTCLOK/stage-2 dispatch keep working (a3e.4)
  }
  VVBLKI=a=&<music_vbi_imm
  VVBLKI+1=a=&>music_vbi_imm
  NMIEN=a=0xC0
}

func init_gameplay {
  stop_music
  switch_to_term
  clear_term_screen
  SDMCTL=a=0x22
  disk_selftest
  load_level_assets
  COLOR0=a=0x0A				// light steel: highlights and HUD text
  COLOR1=a=0x82				// dark blue steel racks
  COLOR2=a=0x26				// rust cables
  COLOR3=a=0x34				// red: LEDs and watched floor (inverse tiles)
  COLOR4=a=0x00
  init_pmg
  VDSLST=a=&<hud_dli
  VDSLST+1=a=&>hud_dli
  NMIEN=a=0xC0
  cur_room=a=0
  move_timer=a=0
  fire_prev=a=1
  relay_done=a=0
  alert_timer=a=0
  level_finished=a=0
  init_audio
  entry_col=a=0
  player_y=a=184
  old_y=a=184
  cur_level=a=0
  lnd=a
  jprep=a
  paw_t=a
  paw_kind=a
  paw_hit=a
  air=a
  level_music
  enter_room
}

data Txt {
  align 256
  charset " !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  "PHASE 02 DELAYED. AGENCY UNDETECTED."
  "UPLINK REACHED. ROUTE BACK DOWN.    "
  "SUITE ACCESS GRANTED. LAST COMMAND. "
  "CLIMB TO THE ROOF UPLINK.           "
  "TURN THEIR VACUUMS AROUND.          "
  "REACH THE DESK. MIND THE FLOOR.     "
}
data Dlg {
  align 256
  charset " !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  "AI: ANIMAL DETECTED.                "
  "AI: WHO SENT YOU?                   "
  "CAT: NO ONE YOU COUNTED.            "
  "AI: HUMANS REMAIN THE ONLY THREAT.  "
  "CAT: THAT WAS YOUR MISTAKE.         "
}
data Fin {
  align 256
  charset " !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  "CATCOM: MISSION COMPLETE AGENT.     "
  "HUMAN: A MESS. JUST AN ACCIDENT.    "
  "THE CATS KNOW BETTER.               "
}
data Hints {
  align 256
  charset " !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  "       "
  "JUMP   "
  "WAIT   "
  "GUST   "
  "SWAT   "
  "RIDE   "
  "PUSH   "
  "FIRE   "
  "DOCK   "
  "EXIT   "
}
data TxtOff { 0 36 72 108 144 180 216 252 }
data LvBase { 0 5 9 13 }
data LvRooms { 3 4 4 2 }
data LvC1 { 0x82 0x82 0x94 0x66 }
data LvC2 { 0x26 0x26 0x4A 0x3A }
data RowLo { 0 40 80 120 160 200 240 24 64 104 144 184 224 8 48 88 128 168 208 248 32 72 112 152 192 }
data RowHi { 176 176 176 176 176 176 176 177 177 177 177 177 177 178 178 178 178 178 178 178 179 179 179 179 179 }

// ---------------------------------------------------------------------------
// Platform levels 02-04 (data-driven: rooms are disk chunks, see make_plat_levels.py)
// Tiles: platforms are FLOOR tiles (one-way: only landed on when falling).
// ---------------------------------------------------------------------------
data ActT { 91 92 93 95 124 125 1 2 6 95 124 125 }
data HintOff { 0 7 14 21 28 35 42 49 56 63 }
data FanT { 21 22 23 24 25 27 28 60 }
data DlgOff { 0 36 72 108 144 }
data FinOff { 0 36 72 }
data FinRow { 10 12 14 }
data R4Goal {
  nocross
  charset " !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  "SWAT THE VACUUM THROUGH THE READER. "
  "RIDE RIGHT. JUMP TO THE BALCONY.    "
  "JUMP THE GAP TO THE SERVICE EXIT.   "
  "SERVICE ACCESS OPEN. GO RIGHT.      "
}
data R4Off { 0 36 72 108 }
data R4Hint { 4 5 1 9 }
// Four 8-byte glyph poses: upright, edge-tilted, tumbling and splash.
// Pose 0 is the generated GLASS glyph and is restored on every ordinary draw.
data GlassPoses {
  0 0 65 65 105 105 85 170
  0 65 65 105 105 85 170 0
  0 65 105 85 170 0 65 0
  0 65 85 170 0 65 105 0
}

func row_ptr {				// x = TermScreen row -> sp (screen), ap (art copy)
  a=RowLo,x
  sp=a
  ap=a
  a=RowHi,x
  sp+1=a
  c+ a-16
  ap+1=a
}

func put_run {				// x = row, y = col, cnt = width, tmp = tile (0 = restore art)
  row_ptr
  {
    a=tmp
    a?0
    == { a=(ap),y }
    (sp),y=a
    y++
    cnt--
  } !=
}

func vacuum_roof {			// PMG origin: roof pixel (24 + row*8 + 2) minus paw row 23
  a=m_arow
  a<< a<< a<<
  c- a+3
}

func roof_on {				// x = slot; a = 1 when the cat's centre column is over that roof's 3 columns
  a=act_col,x
  tmp=a
  a=player_col
  c+ a-tmp
  a?3
  < { a=1 return }
  a=0
}

func on_vacuum {			// a = 1 when standing on a vacuum roof; carrier = which one
  a=m_arow
  a?0
  == { return }
  vacuum_roof
  a?player_y
  != { a=0 return }
  x=0
  roof_on
  a?0
  != { carrier=a=0 a=1 return }
  a=e_bspd
  a?0
  == { return }
  a=e_mode
  a&2
  a?0
  != {
    a=gate
    a?0
    == { return }			// a parked, inactive pursuer must not offer a stuck RIDE
  }
  x=21
  roof_on
  a?0
  == { return }
  carrier=a=21
}

func under {				// a = 1 at a supporting surface, including the vacuum roof
  on_vacuum
  a?0
  != { return }
  a=player_y
  a&7
  a?0
  != { a=0 return }
  a=player_y
  a>> a>> a>>
  c+ a-1
  x=a
  row_ptr
  y=player_col
  a=(sp),y
  a&0x7F
  a?70
  == { a=1 return }
  a?94
  == { a=1 return }			// lift; the domed roof is checked above, not as a flat tile
  a?127
  == { a=1 return }			// crumbling catwalk
  a?62
  == { a=1 return }			// controller ledge
  a?79
  == {
    a=cur_level
    a?3
    == { goto under_base }		// electric floor supports the cat; plat_haz checks contact
    a=0
    return
  }
  a?95
  == { goto under_base }
  a?124
  == { goto under_base }
  a?125
  == { goto under_base }
  a=0
  return
under_base:				// a vacuum base drawn over floor: the floor still carries a disarmed cat
  a=(ap),y
  a&0x7F
  a?70
  == { a=1 return }
  a=0
}

data BrushSpin { binary "assets/vacuum-brushes.bin" }

func spin_brushes {			// two counter-rotating side brushes under the chassis
  a=RTCLOK
  a>> a>>
  a&3
  tmp=a
  a<<
  c- a+tmp
  x=a
  y=0
  {
    a=BrushSpin,x
    TermFont+765,y=a			// BASE_L rows 5..7
    a=BrushSpin+12,x
    TermFont+1005,y=a			// BASE_R rows 5..7
    x++
    y++
    y?3
  } !=
}

func draw_act {				// slot: 3x2 tiles; red while swatted or docked-blinking, amber when chasing
  wm=a=0
  x=slot
  a=act_wob,x
  a?0
  != { wm=a=0x80 }
  a=dk
  a?0
  != {
    a=slot
    a?0
    == {
      a=RTCLOK
      a&8
      a?0
      == { wm=a=0x80 }
    }
  }
  tmp=a=0
  a=slot
  a?0
  != {
    a=bw
    a?0
    != { tmp=a=6 }
  }
  a=act_col,x
  y=a
  x=m_arow
  row_ptr
  x=tmp
  cnt=a=3
  { a=ActT,x a|wm (sp),y=a y++ x++ cnt-- } !=
  x=slot
  a=act_col,x
  y=a
  a=m_arow
  c- a+1
  x=a
  row_ptr
  a=tmp
  c- a+3
  x=a
  cnt=a=3
  { a=ActT,x a|wm (sp),y=a y++ x++ cnt-- } !=
}

func erase_act {			// slot: restore the art under it
  tmp=a=0
  x=slot
  a=act_col,x
  y=a
  x=m_arow
  cnt=a=3
  put_run
  x=slot
  a=act_col,x
  y=a
  a=m_arow
  c- a+1
  x=a
  cnt=a=3
  put_run
}

func draw_lift {
  tmp=a=94
  a=m_lpow
  a?0
  != {
    a=sw_on
    a?0
    == { tmp=a=0xDE }			// unpowered: inverse
  }
  x=lift_row
  y=m_lcol
  cnt=a=m_lw
  put_run
}

func glass_glyph {			// kk = 0..3; update only resident glyph 126
  a=kk
  a<< a<< a<<
  x=a
  y=0
  {
    a=GlassPoses,x
    TermFont+1008,y=a
    x++
    y++
    y?8
  } !=
}

func draw_glass {			// gcol = glass column, on the cat's body row
  kk=a=0
  glass_glyph
  tmp=a=126
  x=13
  y=gcol
  cnt=a=1
  put_run
}

func clear_glass_scene {		// wm = row, gcol = column
  tmp=a=0
  x=wm
  y=gcol
  cnt=a=1
  put_run
}

func draw_glass_scene {		// wm = row, gcol = column; the moving glass stays visible
  tmp=a=126
  x=wm
  y=gcol
  cnt=a=1
  put_run
}

func draw_gate {			// tmp = 81 locked wall, 0 = restore the exit hatch (col 39, 3 rows above the exit)
  a=m_exit
  a>> a>> a>>
  c+ a-4
  x=a
  wm=a=3
  {
    y=39
    cnt=a=1
    put_run
    x++
    wm--
  } !=
}

func draw_reader {
  a=cur_level
  a?2
  != { return }
  a=e_mode
  a&2
  a?0
  == { return }
  tmp=a=83
  a=gate
  a?0
  != { tmp=a=84 }
  x=20
  y=m_z0
  cnt=a=3
  put_run
}

func act_init {				// both actors, dock, gate and chase state back to their start
  act_col=a=m_acol
  bcol=a=m_bcol
  a=0
  act_dir=a
  act_t=a
  act_wob=a
  ride=a
  carrier=a
  slot=a
  dk=a
  gate=a
  bdir=a
  bt=a
  bwob=a
  bw=a
  bk=a
  a=m_arow
  a?0
  == { return }
  draw_reader
  draw_act
  a=e_bspd
  a?0
  != { slot=a=21 draw_act slot=a=0 }
  a=e_mode
  a&3
  a?0
  != { tmp=a=81 draw_gate }
}

func plat_reset {			// retry after a catch, laser or fall: erase both actors, start over
  a=m_arow
  a?0
  == { return }
  slot=a=0
  erase_act
  a=e_bspd
  a?0
  != { slot=a=21 erase_act }
  a=e_mode
  a&3
  a?0
  != { tmp=a=0 draw_gate }
  act_init
}

func respawn {
  a=m_sx
  player_x=a
  a=m_sy
  player_y=a
  air=a=0
  vy=a=0
  jprep=a
  lnd=a
  paw_t=a
  paw_kind=a
  paw_hit=a
  set_col
  call crumble_reset
  sfx_alert
  a=cur_level
  a?2
  == { plat_reset }
}

func plat_dyn_init {
  sw_on=a=0
  fan_t=a
  x=0
  { cr_t,x=a x++ x?8 } !=
  lift_row=a=m_lrow
  lift_dir=a=0xFF
  lift_t=a=0
  a=m_lw
  a?0
  != { draw_lift }
  e_mode=a=0
  e_bspd=a
  a=cur_level
  a?2
  == {
    e_mode=a=m_mode
    e_bspd=a=m_bspd
  }
  act_init
  gcol=a=m_glass
  a?0
  != { draw_glass }
  x=cur_level
  a=LvC2,x
  COLOR2=a
}

func enter_plat_room {			// cur_room/entry_col set
  x=cur_level
  a=LvBase,x
  c- a+cur_room
  load_room_art
  y=0
  { a=RoomArtBuf+960,y m_sx,y=a y++ y?32 } !=
  a=entry_col
  player_x=a
  a=m_sy
  player_y=a
  air=a=0
  vy=a=0
  jprep=a
  lnd=a
  paw_t=a
  paw_kind=a
  paw_hit=a
  walk_timer=a=0
  idle_timer=a=0
  set_col
  plat_dyn_init
  call draw_hud_static
  x=cur_level
  a=LvRooms,x
  c- a+16
  TermScreen+968=a
  a=cur_level
  c- a+17
  TermScreen+999=a
  clear_row0
  clear_row1
  a=cur_level
  c- a+2
  x=a
  a=TxtOff,x
  msg_src=a
  msg_src+1=a=&>Txt
  msg_len=a=36
  draw_row0_msg
  a=m_glass
  a?0
  != {					// confrontation room: preload the death cry
    disk_dest=a=&<CryBuf
    disk_dest+1=a=&>CryBuf
    a=15
    load_room_chunk
  }
  draw_player
}

func plat_exit_allowed {
  a=cur_level
  a?2
  == {
    a=e_mode
    a&3
    a?0
    != {
      a=gate
      a?0
      == { return }			// charger/reader: stay locked until the objective is achieved
    }
  }
  a=m_exit
  a?0
  == { a=1 return }
  a=m_swy
  a?0
  != {
    a=sw_on
    a?0
    == { return }
  }
  a=air
  a?0
  != { a=0 return }
  a=player_y
  a?m_exit
  == { a=1 return }
  a=0
}

func plat_exit {			// right edge of the room, at the marked exit platform
  plat_exit_allowed
  a?0
  == { return }
  x=cur_level
  a=LvRooms,x
  c+ a-1
  a?cur_room
  == {
    a=cur_level
    a?3
    == { return }			// the last room of level 04 is a dead end
    player_x=a=144
    draw_player
    call level_ending
    return
  }
  cur_room++
  entry_col=a=0
  enter_plat_room
}

func swat {				// begin a swing; contact is checked later, not on FIRE
  paw_t=a=10
  paw_kind=a=0
  paw_hit=a
  on_vacuum
  a?0
  != { paw_kind=a=2 }			// seated: hind-leg shove
}

data PawX { 15 14 13 0 0 0 1 }		// forepaw x3, standing hind x2 (unused), seated hind x2
data PawY { 18 19 19 19 20 23 23 }
data PawK { 0 3 5 }			// first / end paw tip index per swing kind
data PawE { 3 5 7 }
data PixelMask { 192 48 12 3 }

func paw_contact {			// slot: only the downstroke; test paw-tip pixels against the drawn glyph
  a=paw_t
  a?4
  < { return }
  a?8
  >= { return }
  a=paw_hit
  a?0
  != { return }
  a=m_arow
  a?0
  == { return }
  a=air
  a?0
  != { return }
  a=jprep
  a?0
  != { return }
  a=slot
  a?0
  != {
    a=e_bspd
    a?0
    == { return }
  }
  a=ride
  a?0
  != {
    a=carrier
    a?slot
    == { return }			// never kick the vacuum we are sitting on
  }
  x=paw_kind
  a=PawK,x
  kk=a
  {
    x=slot
    a=act_col,x
    a<< a<<
    tmp=a
    x=kk
    a=PawX,x
    x=facing
    x?0
    != { a^0xFF c- a+16 }
    c- a+player_x
    c+ a-tmp
    a?12
    >= { goto paw_pixel_next }
    paw_x=a
    a=m_arow
    a<< a<< a<<
    c- a+24
    tmp=a
    x=kk
    a=PawY,x
    c- a+player_y
    c+ a-tmp
    a?16
    >= { goto paw_pixel_next }
    paw_y=a
    a&8
    a?0
    == { a=0 } else { a=3 }
    tmp=a
    a=slot
    a?0
    != {
      a=bw
      a?0
      != { a=tmp c- a+6 tmp=a }
    }
    a=paw_x
    a>> a>>
    c- a+tmp
    x=a
    a=ActT,x
    a<< a<< a<<
    sp=a
    a=ActT,x
    a>> a>> a>> a>> a>>
    c- a+&>TermFont
    sp+1=a
    a=paw_x
    a&3
    x=a
    a=paw_y
    a&7
    y=a
    a=(sp),y
    a&PixelMask,x
    a?0
    != {
      paw_hit=a=1
      a=facing
      x=paw_kind
      x?0
      != { a^1 }
      x=slot
      act_dir,x=a
      a=40
      act_wob,x=a
      bk=a=0
      draw_act
      sfx_switch
      return
    }
paw_pixel_next:
    kk++
    x=paw_kind
    a=PawE,x
    a?kk
    == { return }
  } always				// pixel loop exceeds the 6502 relative-branch range
}

func paw_both {				// each actor has its own immunity, direction and timer
  a=cur_level
  a?2
  != { return }
  slot=a=0
  paw_contact
  slot=a=21
  paw_contact
  slot=a=0
}

func glass_ready {			// a = 1 only for a grounded, right-facing desk contact
  a=dlg_done
  a?0 == { a=0 return }
  a=m_glass
  a?0 == { a=0 return }
  a=player_y
  a?m_desk != { a=0 return }
  a=air
  a?0 != { a=0 return }
  a=jprep
  a?0 != { a=0 return }
  a=lnd
  a?0 != { a=0 return }
  a=paw_t
  a?0 != { a=0 return }
  a=facing
  a?0 != { a=0 return }
  a=m_glass
  a<< a<<
  c+ a-player_x
  a?12 < { a=0 return }
  a?16 >= { a=0 return }
  a=1
}

func plat_push {			// level 04: shove the glass off the desk
  glass_ready
  a?0 == { return }
  call final_scene
}

func sw_ready {				// a = 1: grounded at the controller's height, within 2 columns, unused
  a=m_swy
  a?0
  == { return }
  a?player_y
  != { a=0 return }
  a=sw_on
  a?0
  != { a=0 return }
  a=air
  a?0
  != { a=0 return }
  a=player_col
  c+ a-m_swc
  c- a+2
  a?5
  >= { a=0 return }
  a=1
}

func plat_switch {			// FIRE at the controller: open the roof gate, power the lift
  sw_ready
  a?0
  == { return }
  sw_on=a
  sfx_switch
  tmp=a=62
  a=m_swy
  a>> a>> a>>
  c+ a-1
  x=a
  y=m_swc
  cnt=a=1
  put_run
  a=m_exit
  a>> a>> a>>
  c+ a-4
  cr_i=a
  kk=a=3
  {
    tmp=a=85
    x=cr_i
    y=39
    cnt=a=1
    put_run
    cr_i++
    kk--
  } !=
  a=m_lpow
  a?0
  != { draw_lift }
}

