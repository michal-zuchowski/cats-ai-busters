// ------------------------------ Timing helper -------------------------------

func wait_frames {			// x = number of VBIs (~frames) to wait; only touches A/X
  {
    a=RTCLOK				// snapshot the current jiffy tick
    { a?RTCLOK } ==			// spin until RTCLOK actually changes (one real tick)
    a=cur_room
    a?0xFF
    == {
      a=TRIG0
      a&1
      a?0
      == { goto intro_skip }
      a=CH
      a?0x21				// Space
      == { goto intro_skip }
      a?0x0C				// Return
      == { goto intro_skip }
    }
    x--
    x?0
  } !=
}

func init_system {
  a=PORTB a|2 PORTB=a		// BASIC ROM off; RAM at $A000-$BFFF holds intro buffers
  cur_room=a=0xFF			// wait_frames checks skip keys only during the intro
  CH=a=0xFF				// discard a key used to launch the XEX
  NMIEN=a=0x40				// enable OS deferred VBI only (no DLI)
  SDMCTL=a=0x22				// normal playfield DMA, no PMG needed here
  SDLSTL=a=&<dl_term
  SDLSTH=a=&>dl_term
  CHBAS=a=&>TermFont
  COLOR0=a=0x0E				// white characters
  COLOR1=a=0x0E
  COLOR2=a=0x0E
  COLOR4=a=0xB4				// dark green CRT background
  // main immediately calls switch_to_storm for the opening shot, which
  // overwrites SDLSTL/H and COLOR0-4 below before the first VBI can latch
  // this dl_term/text palette, so no dl_term flash is visible at boot.
}

inline reveal_palette {
  COLOR4=a=0x00				// black room
  COLOR0=a=0x72				// dark blue silhouettes
  COLOR1=a=0xB6				// sea-green rack frames and screen text
  COLOR2=a=0x1A				// amber LEDs and eyes
}

// 96 LMS pairs; row stride is 64 bytes and both entries point at the same row.
func build_storm_list {
  pan_ptr=a=&<RevealImg+24		// start at the right end of the panorama
  pan_ptr+1=a=&>RevealImg+24
  dl_ptr=a=&<dl_storm+3
  dl_ptr+1=a=&>dl_storm+3
  x=96
  {
    a=0x4E
    y=0
    (dl_ptr),y=a
    y=3
    (dl_ptr),y=a
    y=1
    a=pan_ptr
    (dl_ptr),y=a
    y=4
    (dl_ptr),y=a
    y=2
    a=pan_ptr+1
    (dl_ptr),y=a
    y=5
    (dl_ptr),y=a

    a=pan_ptr
    c- a+64
    pan_ptr=a
    c+? { pan_ptr+1++ }
    a=dl_ptr
    c- a+6
    dl_ptr=a
    c+? { dl_ptr+1++ }
    x--
    x?0
  } !=
}

// Move every pair of LMS addresses back one byte: the camera tracks left.
func pan_step {
  dl_ptr=a=&<dl_storm+3
  dl_ptr+1=a=&>dl_storm+3
  x=96
  {
    y=1
    a=(dl_ptr),y
    c+ a-1
    (dl_ptr),y=a
    c-? {
      y=2
      a=(dl_ptr),y
      c+ a-1
      (dl_ptr),y=a
      y=5
      (dl_ptr),y=a
    }
    y=1
    a=(dl_ptr),y
    y=4
    (dl_ptr),y=a
    a=dl_ptr
    c- a+6
    dl_ptr=a
    c+? { dl_ptr+1++ }
    x--
    x?0
  } !=
}

// Toggle every LED whose 8-step pattern has the current phase bit set.
func blink_rack_leds {
  a=pan_phase
  a&7
  x=a
  a=BitMasks,x
  led_bit=a
  x=0
  {
    a=Leds+121,x
    a?0xFF == break
    c- a+&>RevealImg
    led_ptr+1=a
    a=Leds+363,x
    a&led_bit
    a?0 != {
      led_ptr=a=Leds,x
      y=0
      a=(led_ptr),y
      a^Leds+242,x
      (led_ptr),y=a
    }
    x++
  } always
}

// 24 four-pixel steps at 12 PAL frames each: 288 frames / 50 Hz = 5.76 s.
// LEDs change twice per step.
func storm_pan {
  AUDF2=a=0xF2
  AUDC2=a=0xA2			// low fan noise
  AUDF3=a=0x31
  AUDC3=a=0x84			// quiet continuous data-center hum
  pan_phase=a=0
  x=1 wait_frames			// start LMS updates at VBI, before visible rows
  {
    pan_step
    blink_rack_leds
    x=6 wait_frames
    pan_phase++
    blink_rack_leds
    x=6 wait_frames
    pan_phase++
    a=pan_phase
    a?48
  } !=
}

// Double the last 80x48 pixels around the far monitor into spare XL RAM.
func build_zoom_bitmap {
  pan_ptr=a=&<RevealImg+961
  pan_ptr+1=a=&>RevealImg+961
  art_ptr=a=&<ZoomBuf
  art_ptr+1=a=&>ZoomBuf
  zoom_second_ptr=a=&<ZoomBuf+40
  zoom_second_ptr+1=a=&>ZoomBuf+40
  zoom_rows=a=48
  {
    zoom_col=a=0
    zoom_dest_col=a=0
    {
      y=zoom_col
      a=(pan_ptr),y
      x=a
      y=zoom_dest_col
      a=ZoomLeft,x
      (art_ptr),y=a
      y++
      a=ZoomRight,x
      (art_ptr),y=a
      y++
      zoom_dest_col=y
      zoom_col++
      a=zoom_col
      a?20
    } !=
    y=0
    {
      a=(art_ptr),y
      (zoom_second_ptr),y=a
      y++
      y?40
    } !=
    a=pan_ptr
    c- a+64
    pan_ptr=a
    c+? { pan_ptr+1++ }
    a=art_ptr
    c- a+80
    art_ptr=a
    c+? { art_ptr+1++ }
    a=zoom_second_ptr
    c- a+80
    zoom_second_ptr=a
    c+? { zoom_second_ptr+1++ }
    zoom_rows--
    a=zoom_rows
    a?0
  } !=
}

func build_zoom_list {
  pan_ptr=a=&<ZoomBuf
  pan_ptr+1=a=&>ZoomBuf
  dl_ptr=a=&<dl_reveal+3
  dl_ptr+1=a=&>dl_reveal+3
  x=96
  {
    y=1
    a=pan_ptr
    (dl_ptr),y=a
    y=4
    (dl_ptr),y=a
    y=2
    a=pan_ptr+1
    (dl_ptr),y=a
    y=5
    (dl_ptr),y=a
    a=pan_ptr
    c- a+40
    pan_ptr=a
    c+? { pan_ptr+1++ }
    a=dl_ptr
    c- a+6
    dl_ptr=a
    c+? { dl_ptr+1++ }
    x--
    x?0
  } !=
}

func show_zoom_bitmap {
  build_zoom_bitmap
  build_zoom_list
  SDLSTL=a=&<dl_reveal
  SDLSTH=a=&>dl_reveal
  reveal_palette
  x=16 wait_frames
}

// Composite the cat only after the terminal shot; scrolling never exposes it.
func show_cat {
  strip_ptr=a=&<CatStrip
  strip_ptr+1=a=&>CatStrip
  art_ptr=a=&<RevealImg+4096
  art_ptr+1=a=&>RevealImg+4096
  x=32
  {
    y=0
    {
      a=(strip_ptr),y
      (art_ptr),y=a
      y++
      y?12
    } !=
    a=strip_ptr
    c- a+12
    strip_ptr=a
    c+? { strip_ptr+1++ }
    a=art_ptr
    c- a+64
    art_ptr=a
    c+? { art_ptr+1++ }
    x--
    x?0
  } !=
}

func build_reveal_list {
  y=0
  {
    a=dl_storm,y
    dl_reveal,y=a
    a=dl_storm+256,y
    dl_reveal+256,y=a
    y++
    y?0
  } !=
  y=0
  {
    a=dl_storm+512,y
    dl_reveal+512,y=a
    y++
    y?70
  } !=
  dl_reveal+420=a=0xCE		// recolor at the floor, after rack row 69
}

naked reveal_dli {
  a!!
  WSYNC=a
  COLPF0=a=0x72
  COLPF1=a=0x08
  COLPF2=a=0x2C
  a??
  return_i
}

// --------------------------- Terminal line reveal ---------------------------
// Each line is copied byte-by-byte from its data table into the visible
// TermScreen row; lines appear sequentially per intro.md.

func reveal_line0 {
  y=0
  {
    a=Line0,y
    TermScreen,y=a
    y++
    y?36
  } !=
}

func reveal_line1 {
  y=0
  {
    a=Line1,y
    TermScreen+40,y=a
    y++
    y?21
  } !=
}

func reveal_line2 {
  y=0
  {
    a=Line2,y
    TermScreen+80,y=a
    y++
    y?25
  } !=
}

func reveal_line3 {
  y=0
  {
    a=Line3,y
    TermScreen+120,y=a
    y++
    y?29
  } !=
}

func reveal_line4 {
  y=0
  {
    a=Line4,y
    TermScreen+160,y=a
    y++
    y?32
  } !=
}

func reveal_line5 {
  y=0
  {
    a=Line5,y
    TermScreen+200,y=a
    y++
    y?26
  } !=
}

func reveal_line6 {
  y=0
  {
    a=Line6,y
    TermScreen+240,y=a
    y++
    y?27
  } !=
}

// --------------------------- Blinking cursor / Y_ ---------------------------
// "pause before Y_": the cursor blinks alone on row 7 first, then "Y" appears
// and the cursor keeps blinking beside it (per intro.md).

func blink_prompt {
  y=6					// 6 half-cycles: 3 full blinks before "Y" appears
  {
    a=TermScreen+280
    a?0
    == {
      TermScreen+280=a=63	// '_' cursor visible
    } else {
      TermScreen+280=a=0	// blank
    }
    x=18 wait_frames
    y--
    y?0
  } !=
}

func show_y_prompt {
  TermScreen+280=a=57		// 'Y'
  y=4					// keep blinking the cursor a bit longer beside "Y"
  {
    a=TermScreen+281
    a?0
    == {
      TermScreen+281=a=63
    } else {
      TermScreen+281=a=0
    }
    x=18 wait_frames
    y--
    y?0
  } !=
  TermScreen+281=a=63		// leave the cursor visible for the cut
}

// ----------------------------- Scene switches -------------------------------

func switch_to_storm {
  SDLSTL=a=&<dl_storm
  SDLSTH=a=&>dl_storm
  reveal_palette
}

// Rows 12-95 of the close-up: every scanline starts with the cat's gray fur
// and cream muzzle in COLPF1/COLPF2, then switches to the data center's
// green/amber between x=84 and x=99 so the racks keep the colors of the opening track.
// The kernel owns the CPU for 168 scanlines, so it also plays every third
// line's meow sample through audc_ptr (a dummy byte when the meow is idle).
naked face_kernel {
  a!!
  a=x
  a!!
  a=y
  a!!
  { a=VCOUNT a?28 } !=		// scanline 56: first line of row 12
  WSYNC=a
  face_groups=a=56			// 56 x 3 scanlines
  {
    a=0x08 COLPF1=a			// gray fur
    a=0x2C COLPF2=a			// cream muzzle
    x=0x1A y=0
    a=(meow_ptr),y
    a|0x10
    (audc_ptr),y=a
    y=0xB6
    *2
    COLPF1=y COLPF2=x
    WSYNC=a

    a=0x08 COLPF1=a
    a=0x2C COLPF2=a
    x=0x1A y=0xB6
    a=meow_ptr c- a+1 meow_ptr=a	// constant time: no jitter on page crossings
    a=meow_ptr+1 a+0 meow_ptr+1=a
    *2
    COLPF1=y COLPF2=x
    WSYNC=a

    a=0x08 COLPF1=a
    a=0x2C COLPF2=a
    x=0x1A y=0xB6
    *15
    face_groups--
    COLPF1=y COLPF2=x
    WSYNC=a
  } !=
  a??
  y=a
  a??
  x=a
  a??
  return_i
}

func switch_to_reveal {
  SDLSTL=a=&<dl_reveal
  SDLSTH=a=&>dl_reveal
  VDSLST=a=&<reveal_dli
  VDSLST+1=a=&>reveal_dli
  reveal_palette
  NMIEN=a=0xC0
}

func switch_to_face {
  VDSLST=a=&<face_kernel
  VDSLST+1=a=&>face_kernel
  audc_ptr=a=&<meow_sink
  audc_ptr+1=a=&>meow_sink
  SDLSTL=a=&<dl_face
  SDLSTH=a=&>dl_face
  reveal_palette			// the data center keeps the colors of the track
  NMIEN=a=0xC0
}

func switch_to_term {
  SDLSTL=a=&<dl_term
  SDLSTH=a=&>dl_term
  COLOR0=a=0x0E				// white text independent of background
  COLOR1=a=0x0E
  COLOR2=a=0x0E
  COLOR4=a=0xB4				// dark green CRT background
}

func clear_term_screen {
  y=0
  a=0
  {
    TermScreen,y=a
    TermScreen+256,y=a
    TermScreen+512,y=a
    y++
    y?0
  } !=
  y=0
  {
    TermScreen+768,y=a
    y++
    y?232
  } !=
}

func zoom_bar {
  y=zoom_left
  {
    (zoom_ptr),y=a=13
    y++
    y?zoom_right
  } !=
}

func zoom_frame {
  clear_term_screen
  zoom_bar
  x=zoom_rows
  {
    y=zoom_left
    (zoom_ptr),y=a=59
    y=zoom_right
    (zoom_ptr),y=a=61
    a=zoom_ptr
    c- a+40
    zoom_ptr=a
    c+? { zoom_ptr+1++ }
    x--
    x?0
  } !=
  a=zoom_ptr
  c+ a-40
  zoom_ptr=a
  c-? { zoom_ptr+1-- }
  zoom_bar
  y=zoom_left
  (zoom_ptr),y=a=59
  y=zoom_right
  (zoom_ptr),y=a=61
}

func zoom_to_terminal {
  switch_to_term
  zoom_ptr=a=&<TermScreen+40
  zoom_ptr+1=a=&>TermScreen+40
  zoom_left=a=27
  zoom_right=a=39
  zoom_rows=a=14
  zoom_frame
  x=10 wait_frames

  zoom_ptr=a=&<TermScreen
  zoom_ptr+1=a=&>TermScreen
  zoom_left=a=13
  zoom_right=a=35
  zoom_rows=a=19
  zoom_frame
  x=10 wait_frames

  zoom_ptr=a=&<TermScreen
  zoom_ptr+1=a=&>TermScreen
  zoom_left=a=1
  zoom_right=a=38
  zoom_rows=a=24
  zoom_frame
  x=10 wait_frames
  clear_term_screen
}

// --------------------- Pupil dilation (slit -> round) -----------------------
// Widen the dark slit through the blue iris, without copying the whole image.

func pupils_stage1 {
  FaceImg+2095=a=0
  FaceImg+2093=a=0
  FaceImg+2089=a=0
  FaceImg+2087=a=0
}

func pupils_stage2 {
  FaceImg+2055=a=0
  FaceImg+2053=a=0
  FaceImg+2049=a=0
  FaceImg+2047=a=0
  FaceImg+2135=a=0
  FaceImg+2133=a=0
  FaceImg+2129=a=0
  FaceImg+2127=a=0
}

func pupils_stage3 {
  FaceImg+1975=a=0
  FaceImg+1973=a=0
  FaceImg+1969=a=0
  FaceImg+1967=a=0
  FaceImg+2015=a=0
  FaceImg+2013=a=0
  FaceImg+2009=a=0
  FaceImg+2007=a=0
  FaceImg+2175=a=0
  FaceImg+2173=a=0
  FaceImg+2169=a=0
  FaceImg+2167=a=0
  FaceImg+2215=a=0
  FaceImg+2213=a=0
  FaceImg+2209=a=0
  FaceImg+2207=a=0
}

// ------------------------------ Mouth sync ----------------------------------
// Called from play_meow's sample loop (once per 256-sample
// page, i.e. 12 times across playback) so the mouth animates during the meow.

inline mouth_open {
  FaceImg+2732=a=0
  FaceImg+2731=a=0
  FaceImg+2772=a=0
  FaceImg+2771=a=0
  FaceImg+2812=a=0
  FaceImg+2811=a=0
  FaceImg+2852=a=0
  FaceImg+2851=a=0
}

inline mouth_close {
  FaceImg+2732=a=175
  FaceImg+2731=a=232
  FaceImg+2772=a=175
  FaceImg+2771=a=232
  FaceImg+2812=a=171
  FaceImg+2811=a=168
  FaceImg+2852=a=170
  FaceImg+2851=a=168
}

func mouth_tick {
  a=mouth_flag
  a^1
  mouth_flag=a
  a?0
  == {
    mouth_close
  } else {
    mouth_open
  }
}

func play_meow {
  x=1 wait_frames			// set up in vblank, outside face_kernel
  meow_ptr=a=&<Meow
  meow_ptr+1=a=&>Meow
  meow_page=a
  audc_ptr=a=&<AUDC1
  audc_ptr+1=a=&>AUDC1
  {
    WSYNC=a
    WSYNC=a
    WSYNC=a
    y=0
    a=(meow_ptr),y
    a|0x10
    AUDC1=a
    meow_ptr++
    == { meow_ptr+1++ }
    a=meow_ptr+1
    a?meow_page != {		// a new 256-sample page (main or kernel crossed it)
      meow_page=a
      mouth_tick			// 12 toggles, one per sample page
      a=meow_page
      a?&>Meow+3072 == break
    }
  } always
  audc_ptr=a=&<meow_sink
  audc_ptr+1=a=&>meow_sink
  AUDC1=a=0
}

func call_mouth {			// x=0 closed, x=6 open
  a=CallMouth,x CallImg+1896=a
  a=CallMouth+1,x CallImg+1897=a
  a=CallMouth+2,x CallImg+1936=a
  a=CallMouth+3,x CallImg+1937=a
  a=CallMouth+4,x CallImg+1976=a
  a=CallMouth+5,x CallImg+1977=a
}

func video_call {
  clear_term_screen
  switch_to_term
  y=0
  {
    a=CallText,y
    TermScreen,y=a
    y++
    y?18
  } !=
  y=0
  {
    a=CallText+18,y
    TermScreen+80,y=a
    y++
    y?27
  } !=
  x=50 wait_frames			// ~4 s total so the connect text can be read
  TermScreen+107=a=14
  x=30 wait_frames
  TermScreen+108=a=14
  x=30 wait_frames
  TermScreen+109=a=14
  x=90 wait_frames

  clear_term_screen
  SDLSTL=a=&<dl_call
  SDLSTH=a=&>dl_call
  COLOR0=a=0x0E			// white Persian cat and subtitles
  COLOR1=a=0x06			// Blofeld's suit and armchair
  COLOR2=a=0x2A			// skin, copper eyes, diamond collar
  COLOR4=a=0x00
  x=35 wait_frames
  call_src=a=&<CallText+45
  call_src+1=a=&>CallText+45
  call_lines_left=a=6
  {
    y=0
    a=(call_src),y
    call_count=a
    a=call_src
    c- a+1
    call_src=a
    c+? { call_src+1++ }
    y=0
    a=0
    {
      TermScreen+840,y=a
      y++
      y?40
    } !=
    y=0
    {
      a=(call_src),y
      TermScreen+840,y=a
      y++
      y?call_count
    } !=
    a=call_src
    c- a+call_count
    call_src=a
    c+? { call_src+1++ }
    a=call_lines_left
    a&1
    a?0 != {
      call_tile=a=4			// boss lines: four mouth flaps with a purr blip
      {
        x=6 call_mouth
        AUDF4=a=0x60
        AUDC4=a=0xA3
        x=6 wait_frames
        x=0 call_mouth
        AUDC4=a=0
        x=6 wait_frames
        call_tile--
        a=call_tile
        a?0
      } !=
      x=152 wait_frames
    } else {
      x=200 wait_frames
    }
    call_lines_left--
    a=call_lines_left
    a?0
  } !=
  x=65 wait_frames
}

// ------------------------------- Cut to black --------------------------------

func cut_to_black {
  COLOR0=a=0
  COLOR1=a=0
  COLOR2=a=0
  COLOR3=a=0
  COLOR4=a=0
  AUDC2=a=0
  AUDC3=a=0
  AUDC4=a=0
}

// ------------------------------ Level 01 gameplay ----------------------------
// Illustrated 40x24 rooms share a walkable row 22; RoomArt provides
// the background, tile IDs 64..124 in TermFont the graphics.
// Ceiling cameras sweep a light cone; the floor under its footprint is seen
// unless a rack stands there (the art's floor row holds SHADOW, not FLOOR).
// cam_sees is both what repaint_current draws and what check_detection uses.

func clear_row0 {
  x=0
  a=0
  {
    TermScreen,x=a
    x++
    x?40
  } !=
}

func clear_row1 {
  x=0
  a=0
  {
    TermScreen+40,x=a
    x++
    x?40
  } !=
}

func draw_row0_msg {			// msg_src/msg_len set by the caller
  y=0
  {
    a=(msg_src),y
    TermScreen,y=a
    y++
    y?msg_len
  } !=
}

func draw_row1_msg {			// msg_src/msg_len set by the caller
  y=0
  {
    a=(msg_src),y
    TermScreen+40,y=a
    y++
    y?msg_len
  } !=
}

func draw_room_header {		// row 1: reuses "CONTROL INFRASTRUCTURE"
  a=cur_room				// from the intro's Line4, or MsgRoute once
  a?2					// the relay in room 2 is diverted
  == {
    a=relay_done
    a?0
    != {
      msg_src=a=&<MsgRoute
      msg_src+1=a=&>MsgRoute
      msg_len=a=22
      draw_row1_msg
      return
    }
  }
  msg_src=a=&<Line4+10
  msg_src+1=a=&>Line4+10
  msg_len=a=22
  draw_row1_msg
}

func draw_player {			// PMG cat: stride frame from x (paws stay planted), else idle
  a=walk_timer
  a?0
  == {
    a=idle_timer
    a?30
    >= { a=13 } else { a=12 }
  } else {
    a=player_x			// 1 drawing per colour clock
    { a?12 >= { c+ a-12 } } >=	// mod 12: 12-drawing stride
    x=facing
    x?0
    != { a^0xFF c- a+12 }		// mirrored frames play forward while x falls
  }
  x=facing
  x?0
  != { c- a+14 }
  x=a
  a&1
  a?0
  == { a=0 } else { a=0x80 }
  spr_ptr=a
  a=x
  a>>
  c- a+&>CatSprites
  spr_ptr+1=a
  y=0
  { a=(spr_ptr),y PmP0,y=a y++ y?24 } !=
  y=32
  { a=(spr_ptr),y PmP1,y=a y++ y?56 } !=
  y=64
  { a=(spr_ptr),y PmP2,y=a y++ y?88 } !=
  y=96
  { a=(spr_ptr),y PmP3,y=a y++ y?120 } !=
  a=player_x
  c- a+48
  HPOSP0=a
  HPOSP2=a
  c- a+8
  HPOSP1=a
  HPOSP3=a
}

func set_col {				// player_col = column under the cat's middle
  a=player_x
  c- a+2
  a>>
  a>>
  c- a+2
  player_col=a
}

func cat_stepped {			// 1 px per 3 frames: half-size cat, same leg cadence
  walk_timer=a=4
  move_timer=a=2
  set_col
}

func tick_cat {
  a=walk_timer
  a?0
  != { walk_timer-- }
  idle_timer++
  a=idle_timer
  a?40
  >= { idle_timer=a=0 }
}

func repaint_current {			// repaints play-row column x for the current room
  a=cur_room
  a?2
  == {
    x?33
    == {
      a=relay_done
      a?0
      == { a=83 } else { a=84 }
      TermScreen+880,x=a
      return
    }
    x?38
    == {
      a=relay_done
      a?0
      == { a=81 } else { a=85 }
      TermScreen+880,x=a
      return
    }
  }
  call cam_sees
  a?0
  != { a=117 TermScreen+880,x=a return }
  a=x
  y=a
  a=(floor_ptr),y
  TermScreen+880,x=a
}

func init_pmg {
  a=0
  y=0
  {
    PmMem,y=a
    PmMem+256,y=a
    PmMem+512,y=a
    PmMem+768,y=a
    y++
    y?0
  } !=
  a=0					// normal-width players: half-size cat
  SIZEP0=a
  SIZEP1=a
  SIZEP2=a
  SIZEP3=a
  PMBASE=a=0xB8
  GRACTL=a=2				// players only
  SDMCTL=a=0x3A				// playfield + single-line player DMA
  GPRIOR=a=1				// cat in front of the racks
  PCOLR0=a=0x24				// P0/P1: stripes, nose, far legs (dark ginger)
  PCOLR1=a=0x24
  PCOLR2=a=0x2C				// P2/P3: ginger fur
  PCOLR3=a=0x2C
}

// ---- Room 0: corridor. cols 2..14 shelter, 15..24 camera strip, 25..37 open.






func redraw_zone {
  x=2
  { repaint_current x++ x?40 } !=
}

func cam_sees {				// x = column -> a: 1 if a live camera footprint covers open floor
  a=x
  cone_t=a
  y=a
  a=(floor_ptr),y
  a?70
  != { a=0 return }
  y=0
  {
    a=sl_cam,y
    a?0
    != {
      a=sl_on,y
      a?0
      != {
        a=cone_t
        c+ a-sl_c,y
        < { a^0xFF c- a+1 }		// |x - centre|
        a?sl_hw,y
        < { a=1 return }
        == { a=1 return }
      }
    }
    y++
    y?2
  } !=
  a=0
}

func load_cams {			// CamCfg row for cur_room -> both slots, sweeps restart
  a=cur_room
  a<<
  a<<
  a<<
  a<<
  y=a
  x=0
  {
    a=CamCfg,y sl_cam,x=a y++
    a=CamCfg,y sl_min,x=a sl_c,x=a y++
    a=CamCfg,y sl_max,x=a y++
    a=CamCfg,y sl_speed,x=a sl_wait,x=a y++
    a=CamCfg,y sl_pause,x=a y++
    a=CamCfg,y sl_hw,x=a y++
    a=CamCfg,y sl_gate,x=a y++
    a=CamCfg,y sl_hwstep,x=a y++
    a=0
    sl_dir,x=a
    sl_on,x=a
    x++
    x?2
  } !=
  x=0
  { a=0xFF oldL,x=a x++ x?34 } !=
  cone_dirty=a=1
}

func tick_cam {				// x = slot
  a=sl_cam,x
  a?0
  != {
    a=sl_gate,x
    a?0
    != {
      a=switch_timer
      a?0
      == { a=1 } else { a=0 }
    } else { a=1 }
    a?sl_on,x
    != { sl_on,x=a cone_dirty=a=1 }
    a=sl_wait,x
    a?0
    == {
      a=sl_speed,x
      sl_wait,x=a
      a=sl_dir,x
      a?0
      == { a=sl_c,x c- a+1 } else { a=sl_c,x c+ a-1 }
      sl_c,x=a
      a?sl_max,x
      == { a=1 sl_dir,x=a a=sl_pause,x sl_wait,x=a }
      a=sl_c,x
      a?sl_min,x
      == { a=0 sl_dir,x=a a=sl_pause,x sl_wait,x=a }
      cone_dirty=a=1
    } else {
      c+ a-1
      sl_wait,x=a
    }
  }
}

func tick_cams {			// sweep each camera; redraw cones when anything moved
  x=0
  tick_cam
  x=1
  tick_cam
  a=cone_dirty
  a?0
  != { cone_dirty=a=0 call redraw_cones }
}

func cone_rows_start {			// zoom_ptr/art_ptr -> row 5 of screen/room art
  zoom_ptr=a=&<TermScreen+200
  zoom_ptr+1=a=&>TermScreen+200
  a=art_base
  c- a+200
  art_ptr=a
  a=art_base+1
  a+0
  art_ptr+1=a
}

func cone_rows_next {
  a=zoom_ptr
  c- a+40
  zoom_ptr=a
  a=zoom_ptr+1
  a+0
  zoom_ptr+1=a
  a=art_ptr
  c- a+40
  art_ptr=a
  a=art_ptr+1
  a+0
  art_ptr+1=a
}

func erase_slot {			// cone_base = 0/17: restore that slot's spans from RoomArt
  cone_rows_start
  cone_i=a=0
  {
    a=cone_base
    c- a+cone_i
    x=a
    a=oldL,x
    a?0xFF
    != {
      y=a
      a=oldR,x
      c- a+1
      cone_end=a
      {
        a=(art_ptr),y
        (zoom_ptr),y=a
        y++
        a=y
        a?cone_end
      } !=
      a=0xFF
      oldL,x=a
    }
    cone_rows_next
    cone_i++
    a=cone_i
    a?17
  } !=
}

func cone_row {				// one row of the cone: advance the DDA, draw its span
  a=cone_cxl
  c- a+cone_sl
  cone_cxl=a
  a=cone_cxh
  a+cone_sh
  cone_cxh=a
  a=cone_hwl
  c- a+cone_hws
  cone_hwl=a
  a=cone_hwh
  a+0
  cone_hwh=a
  a=cone_cxh
  c+ a-cone_hwh
  < { a=0 }
  cone_L=a
  a=cone_cxh
  c- a+cone_hwh
  >= { a=159 }
  a?160
  >= { a=159 }
  cone_R=a
  a=cone_L
  a>>
  a>>
  cone_lc=a
  a=cone_R
  a>>
  a>>
  cone_rc=a
  c- a+1
  cone_end=a
  a=cone_base
  c- a+cone_i
  x=a
  a=cone_lc
  oldL,x=a
  y=a
  a=cone_rc
  oldR,x=a
  {
    a=(art_ptr),y
    a?64
    == {
      a=y
      a?cone_lc
      == {
        a=cone_L
        a&3
        c- a+109
      } else {
        a?cone_rc
        == {
          a=cone_R
          a&3
          c- a+113
        } else { a=109 }
      }
      (zoom_ptr),y=a
    }
    y++
    a=y
    a?cone_end
  } !=
}

func draw_cone {			// x = slot: 17 rows of light from the lens to the floor
  a=sl_cam,x
  a?0
  == { return }
  a=sl_on,x
  a?0
  == { return }
  a=x
  a?0
  == { a=0 } else { a=17 }
  cone_base=a
  a=sl_hwstep,x
  cone_hws=a
  a=sl_c,x
  c+ a-sl_cam,x
  c- a+40
  y=a
  a=ConeStep,y
  cone_sl=a
  a=ConeStep+80,y
  cone_sh=a
  a=sl_cam,x
  a<<
  a<<
  c- a+2
  cone_cxh=a
  cone_cxl=a=0x80
  cone_hwl=a=0
  cone_hwh=a=1
  cone_rows_start
  cone_i=a=0
  {
    cone_row
    cone_rows_next
    cone_i++
    a=cone_i
    a?17
  } !=
}

func cam_tiles {			// camera glyph turns with the sweep; lens red while live
  x=0
  {
    a=sl_cam,x
    a?0
    != {
      y=a
      a=sl_c,x
      c- a+1
      a?sl_cam,x
      < { a=118 } else {
        a=sl_cam,x
        c- a+1
        a?sl_c,x
        < { a=119 } else { a=68 }
      }
      cone_t=a
      a=sl_on,x
      a?0
      != { a=cone_t a|0x80 cone_t=a }
      a=cone_t
      TermScreen+160,y=a
    }
    x++
    x?2
  } !=
}

func redraw_cones {
  cone_base=a=0
  erase_slot
  cone_base=a=17
  erase_slot
  x=0
  draw_cone
  x=1
  draw_cone
  cam_tiles
}


func tick_switch {			// switch_timer was set-but-never-decremented; without
  a=switch_timer			// this the segment stayed dark (or watched, after the
  a?0				// polarity fix above) forever instead of timing out.
  == { return }
  switch_timer--
}

func check_detection {
  x=player_col
  cam_sees
  a?0
  != { call trigger_alert }
}

func trigger_alert {			// ignored while already alerting; relay_done is untouched
  a=alert_timer
  a?0
  != { return }
  alert_timer=a=90
  relay_progress=a=0
  relay_active=a=0
  switch_timer=a=0
  player_x=a=0
  facing=a=0
  set_col
  walk_timer=a=0
  draw_player
  clear_row0
  msg_src=a=&<MsgAlert
  msg_src+1=a=&>MsgAlert
  msg_len=a=19
  draw_row0_msg
  call sfx_alert
}

func handle_relay {
  a=relay_active
  a?0
  == { return }
  a=player_col
  a?33
  != { relay_active=a=0 relay_progress=a=0 return }
  relay_progress++
  a=relay_progress
  a?90
  >= {
    relay_done=a=1
    relay_active=a=0
    x=33
    repaint_current
    x=38
    repaint_current
    clear_row1
    msg_src=a=&<MsgRoute
    msg_src+1=a=&>MsgRoute
    msg_len=a=22
    draw_row1_msg
    call sfx_success
  }
}

func read_fire {			// edge-triggered: one action per press-release cycle
  a=TRIG0
  a&1
  a?0
  != { fire_prev=a=1 return }
  a=fire_prev
  a?0
  == { return }
  fire_prev=a=0
  a=cur_room
  a?1
  == {
    a=player_col
    a?6
    == { switch_timer=a=250 call sfx_switch }
    return
  }
  a=cur_room
  a?2
  == {
    a=player_col
    a?33
    == {
      a=relay_done
      a?0
      == { relay_active=a=1 }
    }
  }
}

func read_and_move {
  a=move_timer
  a?0
  != { move_timer-- return }

  a=PORTA
  a&4
  a?0
  == {
    facing=a=1
    a=player_x
    a?0
    == {
      a=cur_room
      a?0
      != {
        entry_col=a=136
        cur_room--
        call enter_room
      }
      move_timer=a=6
      return
    }
    player_x--
    cat_stepped
    return
  }

  a=PORTA
  a&8
  a?0
  == {
    facing=a=0
    a=player_x
    a?140
    == {
      a=cur_room
      a?2
      == {
        a=relay_done
        a?0
        == { move_timer=a=6 return }
        player_x=a=144
        cat_stepped
        draw_player
        call level_ending
        return
      }
      entry_col=a=0
      cur_room++
      call enter_room
      move_timer=a=6
      return
    }
    player_x++
    cat_stepped
    return
  }
}

func sfx_switch { AUDF4=a=80 AUDC4=a=0xA8 sfx_timer=a=8 }
func sfx_alert { AUDF4=a=40 AUDC4=a=0xAF sfx_timer=a=20 }
func sfx_success { AUDF4=a=100 AUDC4=a=0xA6 sfx_timer=a=40 }

func tick_audio {
  a=sfx_timer
  a?0
  != {
    sfx_timer--
    a=sfx_timer
    a?0
    == { AUDC4=a=0 }
  }
  call tick_music
}

// Original spy-funk in D minor, one step = one 16th (5 frames); data and
// layout: tools/make_music.py. ch1+2 = one 16-bit 1.79 MHz lead voice (in
// tune; 8-bit pure tones are not), ch3 octave bass, ch4 drums and SFX.
data Music { binary "assets/music.bin" }

func music_step {
  mus_timer=a=5
  x=mus_step
  a=Music,x				// lead: 0 nothing new, 1 cut, k >= 2 note k
  a?2
  >= {
    y=a
    a=Music+334,y			// note k: AUDF1/AUDF2 at 336/352 + k - 2
    AUDF1=a
    a=Music+350,y
    AUDF2=a
    lead_vol=a=12
  }
  a=Music,x
  a?1
  == { lead_vol=a=0 }
  a=mus_step
  a>> a>> a>> a>>
  mus_bar=a
  y=a
  a=mus_step
  a&15
  x=a
  a=mus_bar				// every 4th bar plays the drum fill
  a&3
  a?3
  == { a=x c- a+16 x=a }
  a=Music+272,x				// drum hit
  a?0
  != { drum_type=a drum_t=a=0 }
  a=mus_step
  a&15
  x=a
  a=Music+256,x				// bass: 1 root, 2 octave up
  a?1
  == { a=Music+304,y AUDF3=a bass_vol=a=12 }
  a=Music+256,x
  a?2
  == { a=Music+320,y AUDF3=a bass_vol=a=12 }
  mus_step++				// wraps at 256 = 16 bars
}

func tick_music {
  mus_timer--
  a=mus_timer
  a?0
  == { music_step }
  a=lead_vol				// pluck: 24 frames to silence
  a?0
  != {
    a=RTCLOK
    a&1
    == { lead_vol-- }
  }
  a=lead_vol
  a|0xA0
  AUDC2=a				// the joined pair's volume lives in AUDC2
  a=bass_vol
  a?0
  != { bass_vol-- }
  a|0xA0
  AUDC3=a
  a=sfx_timer				// sound effects own ch4
  a?0
  != { return }
  a=drum_type				// row = type * 8 + frame
  a<< a<< a<<
  c- a+drum_t
  x=a
  a=Music+368,x
  AUDF4=a
  a=Music+400,x
  AUDC4=a
  a=drum_t
  a?7
  != { drum_t++ }
}

naked music_vbi {			// deferred VBI: steady tempo however long a frame takes
  a=level_finished
  a?0
  == { tick_audio }
  goto XITVBV
}

func load_room_art {
  art_ptr=a=&<RoomArt
  art_ptr+1=a=&>RoomArt
  a=cur_room
  a?1
  == {
    art_ptr=a=&<RoomArt+960
    art_ptr+1=a=&>RoomArt+960
  }
  a=cur_room
  a?2
  == {
    art_ptr=a=&<RoomArt+1920
    art_ptr+1=a=&>RoomArt+1920
  }
  a=art_ptr
  art_base=a
  c- a+0x70
  floor_ptr=a
  a=art_ptr+1
  art_base+1=a
  a+0x03
  floor_ptr+1=a
  zoom_ptr=a=&<TermScreen
  zoom_ptr+1=a=&>TermScreen
  x=3
  {
    y=0
    {
      a=(art_ptr),y
      (zoom_ptr),y=a
      y++
      y?0
    } !=
    art_ptr+1++
    zoom_ptr+1++
    x--
    x?0
  } !=
  y=0
  {
    a=(art_ptr),y
    (zoom_ptr),y=a
    y++
    y?192
  } !=
}

func enter_room {
  a=entry_col
  player_x=a
  set_col
  switch_timer=a=0
  relay_active=a=0
  relay_progress=a=0
  walk_timer=a=0
  idle_timer=a=0
  load_room_art
  load_cams
  call draw_hud_static
  clear_row1
  draw_room_header
  msg_src=a=&<MsgStop
  msg_src+1=a=&>MsgStop
  msg_len=a=28
  draw_row0_msg
  redraw_zone
  draw_player
}

func level_ending {
  level_finished=a=1
  clear_row0
  clear_row1
  msg_src=a=&<MsgEnding
  msg_src+1=a=&>MsgEnding
  msg_len=a=36
  draw_row0_msg
  sfx_success
  x=150
  wait_frames
  COLOR0=a=0
  COLOR1=a=0
  COLOR2=a=0
  COLOR4=a=0
  PCOLR0=a=0
  PCOLR1=a=0
  PCOLR2=a=0
  PCOLR3=a=0
  AUDC1=a=0
  AUDC2=a=0
  AUDC3=a=0
  AUDC4=a=0
}

func blink_leds {			// toggle the LED pixel in the SRV_B/SRV_D glyphs (tiles 73/75)
  a=RTCLOK
  a&0x20					// slow blink, ~0.6 s
  a>> a>> a>>
  a|0xAA
  TermFont+586=a			// 73*8+2: "2232" / "2222"
  a=RTCLOK
  a&0x08					// fast activity flicker
  a<<
  a|0xAA
  TermFont+604=a			// 75*8+4: "2322" / "2222"
}

// Row 24 HUD: "ROOM n/3", a status label with a 12-cell bar, "LEVEL 01".
func draw_hud_static {
  y=0
  {
    a=MsgHud,y
    TermScreen+961,y=a
    a=MsgLevel,y
    TermScreen+992,y=a
    y++
    y?8
  } !=
  a=cur_room
  c- a+17				// '1'..'3'
  TermScreen+966=a
}

func hud_label {			// msg_src -> 7 cells at column 11
  y=0
  {
    a=(msg_src),y
    TermScreen+971,y=a
    y++
    y?7
  } !=
}

func hud_bar {				// hud_n filled of 11 cells at columns 19..29
  TermScreen+978=a=122			// HUD_L
  TermScreen+990=a=123			// HUD_R
  x=0
  {
    a=121				// HUD_EMPTY
    x?hud_n
    < { a=120 }				// HUD_FULL
    TermScreen+979,x=a
    x++
    x?11
  } !=
}

naked hud_dli {			// HUD row: gold text, state-coloured bar, blue frame
  a!!
  WSYNC=a
  COLPF0=a=0x1C
  a=hud_col
  COLPF1=a
  COLPF2=a=0x86
  a??
  return_i
}

func fire_prompt {
  hud_col=a=0x1C			// gold
  msg_src=a=&<MsgFireHud
  msg_src+1=a=&>MsgFireHud
  hud_label
  a=RTCLOK				// blinking full bar
  a&16
  == { hud_n=a=11 } else { hud_n=a=0 }
  hud_bar
}

func draw_hud {				// status: alert > switch > relay > blank
  a=alert_timer
  a?0
  != {
    hud_col=a=0x36			// red
    msg_src=a=&<MsgAlertHud
    msg_src+1=a=&>MsgAlertHud
    hud_label
    a=alert_timer			// drains as the alert runs out
    a>> a>> a>>
    hud_n=a
    hud_bar
    return
  }
  a=switch_timer
  a?0
  != {
    hud_col=a=0xC8			// green
    msg_src=a=&<MsgCamOff
    msg_src+1=a=&>MsgCamOff
    hud_label
    a=switch_timer			// 250 frames -> 11 cells: t/32 + t/64 + 1
    a>> a>> a>> a>> a>>
    hud_n=a
    a=switch_timer
    a>> a>> a>> a>> a>> a>>
    c- a+hud_n
    c- a+1
    hud_n=a
    hud_bar
    return
  }
  a=relay_active
  a?0
  != {
    hud_col=a=0x2C			// orange
    msg_src=a=&<MsgRelayHud
    msg_src+1=a=&>MsgRelayHud
    hud_label
    a=relay_progress
    a>> a>> a>>
    hud_n=a
    hud_bar
    return
  }
  a=cur_room				// on the room-2 switch: prompt for fire
  a?1
  == {
    a=player_col
    a?6
    == { fire_prompt return }
  }
  a=cur_room				// on the room-3 relay, until diverted
  a?2
  == {
    a=relay_done
    a?0
    == {
      a=player_col
      a?33
      == { fire_prompt return }
    }
  }
  hud_col=a=0x0C			// white: how far through the room
  msg_src=a=&<MsgHiddenHud
  msg_src+1=a=&>MsgHiddenHud
  hud_label
  a=player_x
  a>> a>> a>> a>>
  c- a+2
  hud_n=a
  hud_bar
}

func game_frame {
  blink_leds
  draw_hud
  a=alert_timer
  a?0
  == {
    read_fire
    read_and_move
    tick_cat
    tick_cams
    tick_switch
    redraw_zone		// repaints the gated play-row tiles
    draw_player		// PMG frame + position
    check_detection
    handle_relay
    return
  }
  alert_timer--
  a=alert_timer
  a?0
  == {
    clear_row0
    redraw_zone
    draw_player
    msg_src=a=&<MsgStop
    msg_src+1=a=&>MsgStop
    msg_len=a=28
    draw_row0_msg
  }
}

func init_gameplay {
  switch_to_term
  COLOR0=a=0x0A				// light steel: highlights and HUD text
  COLOR1=a=0x82				// dark blue steel racks
  COLOR2=a=0x26				// rust cables
  COLOR3=a=0x34				// red: LEDs and watched floor (inverse tiles)
  COLOR4=a=0x00
  init_pmg
  VDSLST=a=&<hud_dli
  VDSLST+1=a=&>hud_dli
  NMIEN=a=0xC0
  cur_room=a=0
  move_timer=a=0
  fire_prev=a=1
  relay_done=a=0
  alert_timer=a=0
  sfx_timer=a=0
  level_finished=a=0
  mus_timer=a=1
  mus_step=a=0
  lead_vol=a=0
  bass_vol=a=0
  drum_type=a=0
  AUDCTL=a=0x50				// ch1 at 1.79 MHz, ch1+ch2 joined (16-bit lead)
  AUDC1=a=0
  NMIEN=a=0x80				// no VBI while the vector is half written
  VVBLKD=a=&<music_vbi
  VVBLKD+1=a=&>music_vbi
  NMIEN=a=0xC0
  entry_col=a=0
  enter_room
}

// ---------------------------------- Scene ------------------------------------

main {
  init_system
  goto intro_skip			// temporary level-only preview; remove to restore the intro
  build_storm_list

  switch_to_storm			// opening shows racks, but not the cat
  storm_pan				// 5.76-second right-to-left track with blinking LEDs

  show_zoom_bitmap
  zoom_to_terminal			// monitor fills the frame before text appears
  reveal_line0
  x=40 wait_frames
  reveal_line1
  x=40 wait_frames
  reveal_line2
  x=40 wait_frames
  reveal_line3
  x=40 wait_frames
  reveal_line4
  x=40 wait_frames
  reveal_line5
  x=40 wait_frames
  reveal_line6
  x=30 wait_frames

  blink_prompt
  show_y_prompt
  x=60 wait_frames			// let "Y_" sit before pulling back

  show_cat				// add the cat only after the terminal scene
  build_reveal_list
  switch_to_reveal			// cut: pull-back reveal of the cat in the dark
  x=90 wait_frames

  switch_to_face			// cut: close-up cat face
  x=40 wait_frames

  pupils_stage1				// slit -> dilating...
  x=25 wait_frames
  pupils_stage2
  x=25 wait_frames
  pupils_stage3				// ...to fully round
  x=30 wait_frames

  mouth_flag=a=0			// deterministic starting state (closed, matches FaceImg)
  play_meow				// mouth_tick fires from inside this, in sync with audio
  x=40 wait_frames

  video_call
intro_skip:
  NMIEN=a=0x40
  s=x=0xFF				// discard nested intro return addresses after a skip
  AUDC1=a=0
  cut_to_black

  init_gameplay
  {
    x=1
    wait_frames
    a=level_finished
    a?0
    == { game_frame }
  } always				// gameplay loop; idles forever once level_finished=1
}
