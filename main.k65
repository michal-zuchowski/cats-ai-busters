// --------------------------- Blinking cursor / Y_ ---------------------------
// "pause before Y_": the cursor blinks alone on row 7 first, then "Y" appears
// and the cursor keeps blinking beside it (per intro.md).

func blink_prompt {
  y=6					// 6 half-cycles: 3 full blinks before "Y" appears
  {
    a=TermScreen+280
    a?0
    == {
      TermScreen+280=a=63	// '_' cursor visible
    } else {
      TermScreen+280=a=0	// blank
    }
    x=18 wait_frames
    y--
    y?0
  } !=
}

func show_y_prompt {
  TermScreen+280=a=57		// 'Y'
  y=4					// keep blinking the cursor a bit longer beside "Y"
  {
    a=TermScreen+281
    a?0
    == {
      TermScreen+281=a=63
    } else {
      TermScreen+281=a=0
    }
    x=18 wait_frames
    y--
    y?0
  } !=
  TermScreen+281=a=63		// leave the cursor visible for the cut
}

// ----------------------------- Scene switches -------------------------------

func switch_to_storm {
  SDLSTL=a=&<dl_storm
  SDLSTH=a=&>dl_storm
  reveal_palette
}

// Rows 12-95 of the close-up: every scanline starts with the cat's gray fur
// and cream muzzle in COLPF1/COLPF2, then switches to the data center's
// green/amber between x=84 and x=99 so the racks keep the colors of the opening track.
// The kernel owns the CPU for 168 scanlines, so it also plays every third
// line's meow sample through audc_ptr (a dummy byte when the meow is idle).
naked face_kernel {
  a!!
  a=x
  a!!
  a=y
  a!!
  { a=VCOUNT a?28 } !=		// scanline 56: first line of row 12
  WSYNC=a
  face_groups=a=56			// 56 x 3 scanlines
  {
    a=0x08 COLPF1=a			// gray fur
    a=0x2C COLPF2=a			// cream muzzle
    x=0x1A y=0
    a=(meow_ptr),y
    a|0x10
    (audc_ptr),y=a
    y=0xB6
    *2
    COLPF1=y COLPF2=x
    WSYNC=a

    a=0x08 COLPF1=a
    a=0x2C COLPF2=a
    x=0x1A y=0xB6
    a=meow_ptr c- a+1 meow_ptr=a	// constant time: no jitter on page crossings
    a=meow_ptr+1 a+0 meow_ptr+1=a
    *2
    COLPF1=y COLPF2=x
    WSYNC=a

    a=0x08 COLPF1=a
    a=0x2C COLPF2=a
    x=0x1A y=0xB6
    *15
    face_groups--
    COLPF1=y COLPF2=x
    WSYNC=a
  } !=
  a??
  y=a
  a??
  x=a
  a??
  return_i
}

func switch_to_reveal {
  SDLSTL=a=&<dl_reveal
  SDLSTH=a=&>dl_reveal
  VDSLST=a=&<reveal_dli
  VDSLST+1=a=&>reveal_dli
  reveal_palette
  NMIEN=a=0xC0
}

func switch_to_face {
  VDSLST=a=&<face_kernel
  VDSLST+1=a=&>face_kernel
  audc_ptr=a=&<meow_sink
  audc_ptr+1=a=&>meow_sink
  SDLSTL=a=&<dl_face
  SDLSTH=a=&>dl_face
  reveal_palette			// the data center keeps the colors of the track
  NMIEN=a=0xC0
}

func switch_to_term {
  NMIEN=a=0x40				// stop the face DLI before displaying the terminal/HUD list
  SDLSTL=a=&<dl_term
  SDLSTH=a=&>dl_term
  COLOR0=a=0x0E				// white text independent of background
  COLOR1=a=0x0E
  COLOR2=a=0x0E
  COLOR4=a=0xB4				// dark green CRT background
}

func clear_term_screen {
  y=0
  a=0
  {
    TermScreen,y=a
    TermScreen+256,y=a
    TermScreen+512,y=a
    y++
    y?0
  } !=
  y=0
  {
    TermScreen+768,y=a
    y++
    y?232
  } !=
}

func zoom_bar {
  y=zoom_left
  {
    (zoom_ptr),y=a=13
    y++
    y?zoom_right
  } !=
}

func zoom_frame {
  clear_term_screen
  zoom_bar
  x=zoom_rows
  {
    y=zoom_left
    (zoom_ptr),y=a=59
    y=zoom_right
    (zoom_ptr),y=a=61
    a=zoom_ptr
    c- a+40
    zoom_ptr=a
    c+? { zoom_ptr+1++ }
    x--
    x?0
  } !=
  a=zoom_ptr
  c+ a-40
  zoom_ptr=a
  c-? { zoom_ptr+1-- }
  zoom_bar
  y=zoom_left
  (zoom_ptr),y=a=59
  y=zoom_right
  (zoom_ptr),y=a=61
}

func zoom_to_terminal {
  switch_to_term
  zoom_ptr=a=&<TermScreen+40
  zoom_ptr+1=a=&>TermScreen+40
  zoom_left=a=27
  zoom_right=a=39
  zoom_rows=a=14
  zoom_frame
  x=10 wait_frames

  zoom_ptr=a=&<TermScreen
  zoom_ptr+1=a=&>TermScreen
  zoom_left=a=13
  zoom_right=a=35
  zoom_rows=a=19
  zoom_frame
  x=10 wait_frames

  zoom_ptr=a=&<TermScreen
  zoom_ptr+1=a=&>TermScreen
  zoom_left=a=1
  zoom_right=a=38
  zoom_rows=a=24
  zoom_frame
  x=10 wait_frames
  clear_term_screen
}

// --------------------- Pupil dilation (slit -> round) -----------------------
// Widen the dark slit through the blue iris, without copying the whole image.

func pupils_stage1 {
  FaceImg+2095=a=0
  FaceImg+2093=a=0
  FaceImg+2089=a=0
  FaceImg+2087=a=0
}

func pupils_stage2 {
