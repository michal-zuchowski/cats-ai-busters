    TermScreen+80,y=a
    y++
    y?25
  } !=
}

func reveal_line3 {
  y=0
  {
    a=Line3,y
    TermScreen+120,y=a
    y++
    y?29
  } !=
}

func reveal_line4 {
  y=0
  {
    a=Line4,y
