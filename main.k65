  repeat 2 { 0x4E &<RevealImg+3400 &>RevealImg+3400 }
  repeat 2 { 0x4E &<RevealImg+3440 &>RevealImg+3440 }
  repeat 2 { 0x4E &<RevealImg+3480 &>RevealImg+3480 }
  repeat 2 { 0x4E &<RevealImg+3520 &>RevealImg+3520 }
  repeat 2 { 0x4E &<RevealImg+3560 &>RevealImg+3560 }
  repeat 2 { 0x4E &<RevealImg+3600 &>RevealImg+3600 }
  repeat 2 { 0x4E &<RevealImg+3640 &>RevealImg+3640 }
  repeat 2 { 0x4E &<RevealImg+3680 &>RevealImg+3680 }
  repeat 2 { 0x4E &<RevealImg+3720 &>RevealImg+3720 }
  repeat 2 { 0x4E &<RevealImg+3760 &>RevealImg+3760 }
  repeat 2 { 0x4E &<RevealImg+3800 &>RevealImg+3800 }
  0x41 &<dl_reveal &>dl_reveal
}

data dl_face {
  align 1024
  0x70 0x70 0x70
  repeat 2 { 0x4E &<FaceImg &>FaceImg }
  repeat 2 { 0x4E &<FaceImg+40 &>FaceImg+40 }
  repeat 2 { 0x4E &<FaceImg+80 &>FaceImg+80 }
  repeat 2 { 0x4E &<FaceImg+120 &>FaceImg+120 }
  repeat 2 { 0x4E &<FaceImg+160 &>FaceImg+160 }
